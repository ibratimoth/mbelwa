<% layout('layouts/main') %>
<%
  const count = events.length;
%>

<style>
  .ev-page, .ev-modal { --teal: var(--delle-teal, #0e697b); --teal-deep: var(--delle-teal-deep, #073a4a); --gold: var(--delle-gold, #e5a000);
             --ink: var(--delle-dark, #0f2530); --muted: var(--delle-muted, #5d7079); --line: var(--delle-border, rgba(15,37,48,.1)); }
  .ev-page .serif, .ev-modal .serif { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -.01em; }

  /* Page header */
  .ev-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.25rem; margin-bottom: 1.75rem; }
  .ev-head h1 { font-size: clamp(1.8rem, 3.6vw, 2.5rem); line-height: 1.1; margin: 0 0 .35rem; color: var(--teal-deep); }
  .ev-head p { margin: 0; color: var(--muted); }
  .ev-tools { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .ev-search { position: relative; }
  .ev-search i { position: absolute; left: .8rem; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 1.15rem; }
  .ev-search input { padding-left: 2.4rem; border-radius: 10px; border: 1px solid var(--line); min-width: 240px; height: 44px; background: #fff; }
  .ev-search input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(14,105,123,.15); }
  .btn-brand-primary { background: var(--teal); color: #fff; border: 0; border-radius: 10px; font-weight: 600; height: 44px; padding: 0 1.25rem; display: inline-flex; align-items: center; gap: .5rem; transition: background .15s, box-shadow .15s; }
  .btn-brand-primary:hover { background: var(--delle-teal-hover, #0a5160); color: #fff; box-shadow: 0 6px 16px rgba(14,105,123,.25); }
  .btn-brand-primary:disabled { opacity: .75; }

  /* Event grid */
  .ev-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.4rem; }
  .ev { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; transition: border-color .2s, box-shadow .2s; }
  .ev:hover, .ev:focus-within { border-color: rgba(14,105,123,.5); box-shadow: 0 14px 34px rgba(7,58,74,.12); }
  .ev-cover { position: relative; height: 190px; background: linear-gradient(135deg, var(--teal-deep), var(--teal)); overflow: hidden; }
  .ev-cover img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
  .ev-cover.empty { display: grid; place-content: center; text-align: center; color: rgba(255,255,255,.8); font-size: .82rem; gap: .3rem; }
  .ev-cover.empty::before { content: ''; position: absolute; right: -50px; bottom: -70px; width: 190px; height: 190px; border-radius: 50%; border: 1px solid rgba(229,160,0,.4); box-shadow: 0 0 0 22px rgba(229,160,0,.06); }
  .ev-cover.empty i { font-size: 2rem; color: var(--gold); }
  .ev-date { position: absolute; top: .8rem; left: .8rem; background: #fff; border-radius: 12px; padding: .4rem .75rem; text-align: center; line-height: 1.05; box-shadow: 0 6px 16px rgba(7,58,74,.22); }
  .ev-date b { display: block; font-size: 1.3rem; font-weight: 700; color: var(--teal-deep); }
  .ev-date span { font-size: .72rem; font-weight: 600; color: var(--gold); filter: brightness(.8); }
  .ev-body { padding: 1.1rem 1.25rem 1.2rem; display: flex; flex-direction: column; flex: 1; }
  .ev-title { font-size: 1.2rem; line-height: 1.25; margin: 0 0 .5rem; }
  .ev-title a { color: var(--ink); text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ev-title a:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; border-radius: 4px; }
  .ev-venue { display: flex; align-items: center; gap: .45rem; color: var(--muted); font-size: .88rem; margin: 0; }
  .ev-venue i { color: var(--teal); font-size: 1.1rem; flex: none; }
  .ev-venue span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ev-foot { margin-top: auto; padding-top: 1rem; display: flex; justify-content: space-between; align-items: center; gap: .5rem; }
  .ev-foot small { color: var(--muted); font-size: .82rem; }
  .ev-go { display: inline-flex; align-items: center; gap: .25rem; font-weight: 600; font-size: .88rem; color: var(--teal); }
  .ev:hover .ev-go { color: var(--teal-deep); }
  .ev:hover .ev-go i { transform: translateX(3px); }
  .ev-go i { font-size: 1.2rem; transition: transform .2s; }

  .ev-new { min-height: 330px; border: 2px dashed rgba(14,105,123,.3); border-radius: 16px; background: transparent; display: grid; place-content: center; text-align: center; gap: .6rem; color: var(--teal); font-weight: 600; padding: 1.5rem; transition: background .2s, border-color .2s; }
  .ev-new:hover { background: rgba(14,105,123,.05); border-color: var(--teal); }
  .ev-new .plus { width: 52px; height: 52px; border-radius: 50%; background: var(--delle-gold-soft, rgba(229,160,0,.14)); color: #9a6a00; display: grid; place-items: center; font-size: 1.6rem; margin: 0 auto; }
  .ev-new small { color: var(--muted); font-weight: 400; }

  /* Empty states */
  .ev-empty { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 3.5rem 1.5rem; text-align: center; }
  .ev-empty .plus { width: 72px; height: 72px; border-radius: 50%; background: var(--delle-gold-soft, rgba(229,160,0,.14)); color: #9a6a00; display: grid; place-items: center; font-size: 2.2rem; margin: 0 auto 1rem; }
  .ev-empty h2 { font-size: 1.5rem; color: var(--teal-deep); }
  .ev-empty p { color: var(--muted); max-width: 420px; margin: .4rem auto 1.4rem; }
  #noMatch { display: none; text-align: center; color: var(--muted); padding: 2rem 0; }

  /* Create-event modal */
  .ev-modal .modal-content { border: 0; border-radius: 22px; overflow: hidden; box-shadow: 0 30px 80px rgba(7,58,74,.3); }
  .ev-modal .m-main { padding: 1.75rem 2rem; }
  .ev-modal h2.m-title { font-size: 1.5rem; color: var(--teal-deep); margin: 0 0 .25rem; }
  .ev-modal .m-sub { color: var(--muted); font-size: .9rem; margin-bottom: 1.4rem; }
  .ev-modal .grp { font-weight: 700; font-size: .95rem; margin: 1.3rem 0 .7rem; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  .ev-modal .grp:first-of-type { border-top: 0; padding-top: 0; margin-top: 0; }
  .ev-modal .form-label { font-size: .85rem; font-weight: 600; color: var(--ink); margin-bottom: .3rem; }
  .ev-modal .form-control { border-radius: 10px; border-color: var(--line); padding: .6rem .8rem; }
  .ev-modal .form-control:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(14,105,123,.15); }
  .ev-modal .opt { color: var(--muted); font-weight: 400; }

  .drop { position: relative; border: 2px dashed rgba(14,105,123,.35); border-radius: 12px; padding: 1.1rem; display: flex; align-items: center; gap: .9rem; background: rgba(14,105,123,.04); transition: background .15s, border-color .15s; }
  .drop:hover, .drop.over { background: rgba(14,105,123,.09); border-color: var(--teal); }
  .drop input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
  .drop .ic { width: 44px; height: 44px; border-radius: 12px; background: var(--teal); color: #fff; display: grid; place-items: center; font-size: 1.4rem; flex: none; }
  .drop strong { display: block; font-size: .92rem; }
  .drop small { color: var(--muted); }
  .drop:focus-within { outline: 3px solid var(--gold); outline-offset: 2px; }

  .m-foot { display: flex; justify-content: flex-end; gap: .6rem; margin-top: 1.6rem; }
  .btn-quiet { background: #fff; border: 1px solid var(--line); border-radius: 10px; height: 44px; padding: 0 1.2rem; font-weight: 600; color: var(--ink); }
  .btn-quiet:hover { background: var(--delle-light-bg, #f4f7f8); }

  .m-side { background: linear-gradient(160deg, var(--teal-deep), var(--teal)); color: #fff; padding: 1.75rem; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; position: relative; overflow: hidden; }
  .m-side::before { content: ''; position: absolute; right: -90px; bottom: -110px; width: 280px; height: 280px; border-radius: 50%; border: 1px solid rgba(229,160,0,.35); box-shadow: 0 0 0 30px rgba(229,160,0,.05); }
  .m-side > * { position: relative; }
  .m-side .lbl { font-size: .82rem; color: rgba(255,255,255,.7); margin-bottom: .9rem; }
  .pv-frame { width: 100%; max-width: 250px; aspect-ratio: 3 / 4; border-radius: 10px; background: rgba(255,255,255,.1); border: 1px dashed rgba(255,255,255,.35); display: grid; place-items: center; overflow: hidden; }
  .pv-frame img { width: 100%; height: 100%; object-fit: cover; display: none; }
  .pv-frame.has img { display: block; } .pv-frame.has { border: 0; box-shadow: 0 20px 40px rgba(0,0,0,.35); }
  .pv-frame.has .pv-ph { display: none; }
  .pv-ph { color: rgba(255,255,255,.7); font-size: .82rem; padding: 1rem; } .pv-ph i { display: block; font-size: 2rem; color: var(--gold); margin-bottom: .3rem; }
  .pv-text { margin-top: 1.1rem; min-height: 4.2rem; }
  .pv-text b { display: block; font-size: 1.15rem; } .pv-text span { display: block; font-size: .85rem; color: rgba(255,255,255,.8); margin-top: .15rem; }

  @media (prefers-reduced-motion: reduce) { .ev-page *, .ev-modal * { transition: none !important; } }
</style>

<div class="ev-page">

  <!-- Header -->
  <header class="ev-head">
    <div>
      <h1 class="serif">Your events</h1>
      <p><%= count === 0 ? 'Create an event to start sending invitations.' : count + (count === 1 ? ' event' : ' events') + '. Open one to manage guests, invitations and check-in.' %></p>
    </div>
    <div class="ev-tools">
      <% if (count > 0) { %>
        <label class="ev-search mb-0">
          <i class="bx bx-search"></i>
          <input type="search" id="evSearch" class="form-control" placeholder="Search by name or venue" aria-label="Search events" autocomplete="off">
        </label>
      <% } %>
      <button type="button" class="btn-brand-primary" data-bs-toggle="modal" data-bs-target="#createEventModal">
        <i class="bx bx-plus fs-5"></i> New event
      </button>
    </div>
  </header>

  <% if (count === 0) { %>
    <section class="ev-empty">
      <div class="plus"><i class="bx bx-calendar-heart"></i></div>
      <h2 class="serif">No events yet</h2>
      <p>Add your first event with its date, venue and invitation card. You can import guests and send invitations right after.</p>
      <button type="button" class="btn-brand-primary mx-auto" data-bs-toggle="modal" data-bs-target="#createEventModal">
        <i class="bx bx-plus fs-5"></i> Create your first event
      </button>
    </section>
  <% } else { %>
    <section class="ev-grid" id="evGrid" aria-label="Events">
      <% events.forEach(event => { %>
        <article class="ev" data-search="<%= ((event.title || '') + ' ' + (event.venue || '')).toLowerCase() %>">
          <div class="ev-cover<%= event.card_template ? '' : ' empty' %>">
            <% if (event.card_template) { %>
              <img src="/public/templates/<%= event.card_template %>" alt="" loading="lazy">
            <% } else { %>
              <i class="bx bx-image-add"></i><span>No invitation card yet</span>
            <% } %>
            <div class="ev-date"><b><%= event.dayStr %></b><span><%= event.monthStr %></span></div>
          </div>
          <div class="ev-body">
            <h2 class="ev-title serif"><a class="stretched-link" href="/events/<%= event.id %>"><%= event.title %></a></h2>
            <p class="ev-venue"><i class="bx bx-map-pin"></i><span title="<%= event.venue %>"><%= event.venue %></span></p>
            <div class="ev-foot">
              <small><%= event.formattedDate %></small>
              <span class="ev-go">Manage <i class="bx bx-right-arrow-alt"></i></span>
            </div>
          </div>
        </article>
      <% }) %>

      <button type="button" class="ev-new" data-bs-toggle="modal" data-bs-target="#createEventModal" id="evNewTile">
        <span class="plus"><i class="bx bx-plus"></i></span>
        <span>Create a new event</span>
        <small>Date, venue and invitation card</small>
      </button>
    </section>
    <p id="noMatch">No events match your search.</p>
  <% } %>
</div>

<!-- Create event modal -->
<div class="modal fade ev-modal" id="createEventModal" tabindex="-1" aria-labelledby="createEventModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <form method="post" action="/events/create" enctype="multipart/form-data" id="createEventForm" class="row g-0">
        <input type="hidden" name="_csrf" id="modalCsrfInput" value="<%= csrfToken %>">

        <div class="col-lg-7 m-main">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h2 class="m-title serif" id="createEventModalLabel">Create an event</h2>
              <p class="m-sub">Add the details guests will see on their invitation.</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="grp">Event</div>
          <div class="mb-3">
            <label class="form-label" for="f_title">Event name</label>
            <input type="text" class="form-control" id="f_title" name="title" placeholder="John and Mary's wedding" required>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f_groom">Groom's name <span class="opt">(optional)</span></label>
              <input type="text" class="form-control" id="f_groom" name="groom_name" placeholder="First and last name">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f_bride">Bride's name <span class="opt">(optional)</span></label>
              <input type="text" class="form-control" id="f_bride" name="bride_name" placeholder="First and last name">
            </div>
          </div>

          <div class="grp">When and where</div>
          <div class="row g-3">
            <div class="col-md-7">
              <label class="form-label" for="f_venue">Venue</label>
              <input type="text" class="form-control" id="f_venue" name="venue" placeholder="Hall name, city" required>
            </div>
            <div class="col-md-5">
              <label class="form-label" for="f_date">Date</label>
              <input type="date" class="form-control" id="f_date" name="event_date" required>
            </div>
          </div>

          <div class="grp">Invitation card</div>
          <div class="drop" id="dropZone">
            <input type="file" id="f_card" name="card_template" accept="image/*" required aria-label="Invitation card image">
            <span class="ic"><i class="bx bx-cloud-upload"></i></span>
            <span>
              <strong id="dropName">Choose or drop your card design</strong>
              <small>Image file. Guest names and QR codes are placed on it next.</small>
            </span>
          </div>

          <div class="m-foot">
            <button type="button" class="btn-quiet" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-brand-primary" id="saveBtn">
              <span id="saveText">Create event</span>
              <span id="saveSpin" class="spinner-border spinner-border-sm d-none"></span>
            </button>
          </div>
        </div>

        <aside class="col-lg-5 m-side d-none d-lg-flex" aria-label="Preview">
          <div class="lbl">Live preview</div>
          <div class="pv-frame" id="pvFrame">
            <img id="templatePreview" alt="Selected invitation card">
            <div class="pv-ph"><i class="bx bx-image-add"></i>Your card appears here</div>
          </div>
          <div class="pv-text">
            <b class="serif" id="pvTitle">Your event name</b>
            <span id="pvNames"></span>
            <span id="pvWhen"></span>
          </div>
        </aside>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const $ = id => document.getElementById(id);

    /* ---- Search ---- */
    const search = $('evSearch');
    if (search) {
      const cards = [...document.querySelectorAll('.ev')];
      search.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach(c => { const hit = !q || c.dataset.search.includes(q); c.style.display = hit ? '' : 'none'; if (hit) shown++; });
        $('evNewTile').style.display = q ? 'none' : '';
        $('noMatch').style.display = shown ? 'none' : 'block';
      });
    }

    /* ---- Modal: live preview ---- */
    const form = $('createEventForm'), modal = $('createEventModal');
    const frame = $('pvFrame'), img = $('templatePreview'), drop = $('dropZone');
    let url = null;

    function clearPreview() {
      if (url) URL.revokeObjectURL(url);
      url = null; img.removeAttribute('src'); frame.classList.remove('has');
      $('dropName').textContent = 'Choose or drop your card design';
    }

    $('f_card').addEventListener('change', function () {
      const file = this.files[0];
      if (!file) return clearPreview();
      if (url) URL.revokeObjectURL(url);
      url = URL.createObjectURL(file);
      img.src = url; frame.classList.add('has');
      $('dropName').textContent = file.name;
    });
    ['dragenter', 'dragover'].forEach(t => drop.addEventListener(t, () => drop.classList.add('over')));
    ['dragleave', 'drop'].forEach(t => drop.addEventListener(t, () => drop.classList.remove('over')));

    function syncText() {
      $('pvTitle').textContent = $('f_title').value.trim() || 'Your event name';
      const g = $('f_groom').value.trim(), b = $('f_bride').value.trim();
      $('pvNames').textContent = [g, b].filter(Boolean).join(' & ');
      const d = $('f_date').value ? new Date($('f_date').value + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
      $('pvWhen').textContent = [d, $('f_venue').value.trim()].filter(Boolean).join(', ');
    }
    ['f_title', 'f_groom', 'f_bride', 'f_venue', 'f_date'].forEach(id => $(id).addEventListener('input', syncText));

    /* ---- Modal: submit state, reset, fresh CSRF ---- */
    form.addEventListener('submit', () => { $('saveBtn').disabled = true; $('saveText').textContent = 'Creating…'; $('saveSpin').classList.remove('d-none'); });
    window.addEventListener('pageshow', () => { $('saveBtn').disabled = false; $('saveText').textContent = 'Create event'; $('saveSpin').classList.add('d-none'); });

    modal.addEventListener('hidden.bs.modal', () => { form.reset(); clearPreview(); syncText(); });
    modal.addEventListener('show.bs.modal', async function () {
      try {
        const response = await fetch('/api/csrf-token');
        const data = await response.json();
        $('modalCsrfInput').value = data.csrfToken;
      } catch (error) {
        console.error('Failed to fetch CSRF token for modal:', error);
      }
    });
    modal.addEventListener('shown.bs.modal', () => $('f_title').focus());
  });
</script>
