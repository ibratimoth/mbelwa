<% layout('layouts/main', { event: event }) %>

<!-- EDITOR BRAND CONTAINER -->
<div class="row g-4 mb-5">
  <!-- LEFT COLUMN: DESCRIPTIONS & CONTROL SYNC ACTIONS -->
  <div class="col-lg-3">
    <div class="card border-0 bg-white p-4 shadow-sm mb-3">
      <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bx bx-move-vertical fs-4 text-secondary"></i>
        <h5 class="fw-bold text-dark mb-0">Layout Engine</h5>
      </div>
      
      <p class="text-muted small mb-4">
        Drag and position the digital overlays directly onto the card canvas template below. The system automatically registers and translates their spatial offsets for bulk invitations.
      </p>

      <hr class="text-muted opacity-25">

      <div class="mb-3">
        <span class="d-block small text-secondary fw-bold mb-1">Configuration Status</span>
        <div class="d-flex align-items-center gap-2 text-success small" id="syncIndicator">
          <i class="bx bx-cloud-check fs-5"></i> <span>Layout configuration synchronized</span>
        </div>
      </div>

      <a href="/events/<%= event.id %>" class="btn btn-delle-outline btn-sm w-100 py-2 d-inline-flex align-items-center justify-content-center gap-2 mt-2">
        <i class="bx bx-arrow-back"></i> Back to Event Summary
      </a>
    </div>
  </div>

  <!-- RIGHT COLUMN: INTERACTIVE DESIGN EDITOR CANVAS WORKSPACE -->
  <div class="col-lg-9">
    <div class="card border-0 bg-white shadow-sm p-4 text-center overflow-auto">
      <div class="mb-3 text-start border-bottom pb-2">
        <h6 class="fw-bold text-dark mb-1"><%= event.title %> — Template Assets Workspace</h6>
        <span class="text-muted small">Drag overlay blocks directly on top of your graphic layer setup.</span>
      </div>

      <div id="canvas-container" class="py-3 d-inline-flex justify-content-center">
        <div id="canvas">
          <!-- Background Template Asset Graphics -->
          <img
            id="preview"
            src="/public/templates/<%= event.card_template %>"
            alt="Template Workspace Background Canvas"
            class="shadow border rounded-3"
          />

          <!-- Guest Name Target Dynamic Overlay Block -->
          <div id="nameBox" class="draggable">
            <div class="d-flex align-items-center gap-1">
              <i class="bx bx-font"></i>
              <span>Guest Name Area</span>
            </div>
          </div>

          <!-- Dynamic QR Access Code Target Dynamic Overlay Block -->
          <div id="qrBox" class="draggable qr-box-style">
            <div class="d-flex flex-column align-items-center justify-content-center h-100 gap-1 text-center">
              <i class="bx bx-qr fs-4"></i>
              <span style="font-size: 10px; font-weight: 600;">QR ACCESS CODE</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- COMPONENT WORKSPACE STYLE LAYERS -->
<style>
  #canvas-container {
    width: 100%;
    overflow-x: auto;
  }

  #canvas {
    position: relative;
    display: inline-block;
  }

  #preview {
    display: block;
    max-height: 550px;
    width: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Structural Drag Mechanics Base Layout System Override */
  .draggable {
    position: absolute;
    cursor: grab;
    user-select: none;
    z-index: 1000;
    transition: box-shadow 0.15s ease-in-out;
  }

  .draggable:active {
    cursor: grabbing;
  }

  /* Name Layer Theme Settings */
  #nameBox {
    font-size: 11px;
    font-weight: 500;
    padding: 6px 12px;
    line-height: 1.2;
    background-color: var(--delle-teal);
    color: #ffffff;
    border-radius: 4px;
    box-shadow: 0 4px 10px rgba(14, 97, 113, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* QR Area Layer Settings */
  #qrBox {
    width: 100px;
    height: 100px;
    background-color: rgba(224, 162, 30, 0.15);
    color: var(--delle-gold);
    border: 2px dashed var(--delle-gold);
    border-radius: 6px;
    box-shadow: 0 4px 12px rgba(224, 162, 30, 0.2);
  }
</style>

<!-- SCRIPTS CODES FUNCTIONAL WORKFLOW -->
<script>
  const eventId = "<%= event.id %>";

  let layout = <%- JSON.stringify(event.layout_config || {}) %>;

  const preview = document.getElementById("preview");
  const nameBox = document.getElementById("nameBox");
  const qrBox = document.getElementById("qrBox");
  const syncIndicator = document.getElementById("syncIndicator");

  preview.onload = () => {
    nameBox.style.left = (layout.nameX ?? 150) + "px";
    nameBox.style.top = (layout.nameY ?? 300) + "px";

    qrBox.style.left = (layout.qrX ?? 450) + "px";
    qrBox.style.top = (layout.qrY ?? 80) + "px";
  };

  let saveTimeout;

  function saveLayout() {
    clearTimeout(saveTimeout);
    
    // Switch to visual pending save status
    syncIndicator.className = "d-flex align-items-center gap-2 text-warning small";
    syncIndicator.innerHTML = `<span class="spinner-border spinner-border-sm" role="status"></span> <span>Saving canvas updates...</span>`;

    saveTimeout = setTimeout(() => {
      const previewRect = preview.getBoundingClientRect();

      const scaleX = preview.naturalWidth / previewRect.width;
      const scaleY = preview.naturalHeight / previewRect.height;

      const normalizedLayout = {
        nameX: layout.nameX * scaleX,
        nameY: layout.nameY * scaleY,
        qrX: layout.qrX * scaleX,
        qrY: layout.qrY * scaleY
      };

      fetch(`/events/${eventId}/layout`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ layout_config: normalizedLayout })
      })
      .then(res => res.json())
      .then(data => {
        // Return visual active confirmation text metrics layout status
        syncIndicator.className = "d-flex align-items-center gap-2 text-success small";
        syncIndicator.innerHTML = `<i class="bx bx-cloud-check fs-5"></i> <span>Layout parameters stored safely</span>`;
      })
      .catch(err => {
        syncIndicator.className = "d-flex align-items-center gap-2 text-danger small";
        syncIndicator.innerHTML = `<i class="bx bx-cloud-lightning fs-5"></i> <span>Save sync fail</span>`;
        console.error(err);
      });

    }, 600); // 600ms debounce gives a slightly more natural feeling delay before hitting network pathways
  }

  function makeDraggable(el, keyX, keyY) {
    let dragging = false;
    let offsetX = 0;
    let offsetY = 0;

    el.addEventListener("mousedown", (e) => {
      dragging = true;
      const rect = el.getBoundingClientRect();
      offsetX = e.clientX - rect.left;
      offsetY = e.clientY - rect.top;
    });

    document.addEventListener("mousemove", (e) => {
      if (!dragging) return;

      const rect = preview.getBoundingClientRect();

      let x = e.clientX - rect.left - offsetX;
      let y = e.clientY - rect.top - offsetY;

      // Keep boundaries restricted inside canvas bounds
      x = Math.max(0, Math.min(x, rect.width - el.offsetWidth));
      y = Math.max(0, Math.min(y, rect.height - el.offsetHeight));

      el.style.left = x + "px";
      el.style.top = y + "px";

      layout[keyX] = x;
      layout[keyY] = y;

      console.log("LAYOUT UPDATED:", layout);

      saveLayout();
    });

    document.addEventListener("mouseup", () => {
      if (dragging) {
        dragging = false;
      }
    });
  }

  makeDraggable(nameBox, "nameX", "nameY");
  makeDraggable(qrBox, "qrX", "qrY");
</script>