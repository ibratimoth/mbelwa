<script>
  let scanner;

  // ⏱ minimum time between scans (2 seconds)
  let lastScanTime = 0;
  const SCAN_DELAY = 2000;

  const startBtn = document.getElementById('start-scanner-btn');
  const stopBtn = document.getElementById('stop-scanner-btn');
  const section = document.getElementById('scanner-section');
  const alertBox = document.getElementById('scanner-alert');
  const scansEl = document.getElementById('scans-remaining');

  function playBeep(type) {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.type = "sine";
    osc.frequency.value = type === "success" ? 800 : 200;
    gain.gain.value = 0.1;

    osc.start();
    setTimeout(() => {
      osc.stop();
      ctx.close();
    }, 200);
  }

  function flash(type) {
    const div = document.createElement("div");

    div.style.position = "fixed";
    div.style.top = 0;
    div.style.left = 0;
    div.style.width = "100%";
    div.style.height = "100%";
    div.style.zIndex = 9999;
    div.style.opacity = 0.5;
    div.style.background = type === "success" ? "green" : "red";

    document.body.appendChild(div);

    setTimeout(() => div.remove(), 200);
  }

  function show(msg, type) {
    alertBox.className = `alert alert-${type}`;
    alertBox.innerText = msg;
    alertBox.classList.remove('d-none');

    setTimeout(() => {
      alertBox.classList.add('d-none');
    }, 2500);
  }

  startBtn.onclick = () => {
    section.style.display = 'block';

    scanner = new Html5Qrcode("qr-reader");

    scanner.start(
      { facingMode: "environment" },
      { fps: 10, qrbox: 250 },
      async (text) => {

        const now = Date.now();

        // ⛔ BLOCK FAST REPEATED SCANS
        if (now - lastScanTime < SCAN_DELAY) return;

        lastScanTime = now;

        try {
          const res = await fetch('/events/<%= event.id %>/scan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ qrData: text })
          });

          const data = await res.json();

          show(data.message, data.success ? 'success' : 'danger');

          playBeep(data.success ? "success" : "error");
          flash(data.success ? "success" : "error");

          if (data.scansRemaining !== undefined) {
            scansEl.innerText = `Scans remaining: ${data.scansRemaining}`;
          }

        } catch (err) {
          show("Network error", "danger");
          playBeep("error");
          flash("error");
        }
      }
    );
  };

  stopBtn.onclick = () => {
    if (scanner) scanner.stop();
    section.style.display = 'none';
  };
</script>