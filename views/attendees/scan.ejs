<% layout('layouts/main', { event: event }) -%>

<h3 class="text-center mb-3">Scan Guests</h3>

<div class="text-center mb-3">
  <button id="start-scanner-btn" class="btn btn-primary">
    <i class="bx bx-qr-scan"></i> Start Scanner
  </button>
</div>

<div id="scanner-section" style="display:none; max-width:360px; margin:auto;">
  <div id="qr-reader"></div>

  <div id="scanner-alert" class="alert mt-2 d-none"></div>

  <div class="text-center mt-2">
    <span id="scans-remaining" class="d-block mb-2">
      Scans remaining: -
    </span>

    <button id="stop-scanner-btn" class="btn btn-danger">
      Stop
    </button>
  </div>
</div>

