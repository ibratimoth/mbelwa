<% layout('layouts/main', { event: event }) -%>
<%
  const up = s => (s || '').toString().toUpperCase();
  const scansOf = g => Number(g.scans) || 0;
  const total   = guests.length;
  const nSingle = guests.filter(g => up(g.type).includes('SINGLE')).length;
  const nDouble = guests.filter(g => up(g.type).includes('DOUBLE')).length;
  const nArrived = guests.filter(g => scansOf(g) >= 1).length;
  const nDup    = guests.filter(g => scansOf(g) > 1).length;
  const nPending = total - nArrived;
%>

<style>
  .gd { --teal: var(--delle-teal, #0e697b); --teal-deep: var(--delle-teal-deep, #073a4a); --gold: var(--delle-gold, #e5a000);
        --ink: var(--delle-dark, #0f2530); --muted: var(--delle-muted, #5d7079); --line: var(--delle-border, rgba(15,37,48,.1));
        --soft: var(--delle-teal-soft, rgba(14,105,123,.08)); --wash: #f4f7f8; --ok: #198754; --bad: #c2255c; }
  .gd .serif { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -.01em; }
  .gd :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }

  /* Header */
  .gd-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .gd-head h1 { font-size: clamp(1.7rem, 3.4vw, 2.3rem); line-height: 1.1; margin: 0 0 .3rem; color: var(--teal-deep); }
  .gd-head p { margin: 0; color: var(--muted); }
  .btn-gd { display: inline-flex; align-items: center; gap: .5rem; height: 44px; padding: 0 1.2rem; border-radius: 10px; font-weight: 600; text-decoration: none; border: 1px solid transparent; transition: background .15s, box-shadow .15s; }
  .btn-gd.primary { background: var(--teal); color: #fff; } .btn-gd.primary:hover { background: var(--delle-teal-hover, #0a5160); color: #fff; box-shadow: 0 6px 16px rgba(14,105,123,.25); }
  .btn-gd.ghost { background: #fff; color: var(--teal); border-color: rgba(14,105,123,.3); } .btn-gd.ghost:hover { background: var(--soft); border-color: var(--teal); color: var(--teal); }

  /* Summary figures */
  .gd-sum { display: grid; grid-template-columns: repeat(4, 1fr); margin-bottom: 1.5rem; }
  .gd-sum > div { padding: .2rem 1.25rem; border-left: 1px solid var(--line); }
  .gd-sum > div:first-child { border-left: 0; padding-left: .2rem; }
  .gd-sum b { display: block; font-size: 1.8rem; font-weight: 700; line-height: 1.1; }
  .gd-sum span { font-size: .82rem; color: var(--muted); }
  .gd-sum .ok b { color: var(--ok); } .gd-sum .bad b { color: var(--bad); } .gd-sum .zero b { color: var(--muted); }

  /* Toolbar */
  .gd-bar { background: #fff; border: 1px solid var(--line); border-radius: 14px 14px 0 0; padding: .9rem 1rem; display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; align-items: center; }
  .gd-search { position: relative; flex: 1 1 260px; max-width: 380px; }
  .gd-search i.bx-search { position: absolute; left: .85rem; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 1.15rem; }
  .gd-search input { width: 100%; height: 44px; border: 1px solid var(--line); border-radius: 10px; background: var(--wash); padding: 0 2.4rem 0 2.5rem; font-size: .92rem; transition: background .15s, border-color .15s, box-shadow .15s; }
  .gd-search input:focus { outline: 0; background: #fff; border-color: var(--teal); box-shadow: 0 0 0 3px rgba(14,105,123,.15); }
  .gd-search kbd { position: absolute; right: .7rem; top: 50%; transform: translateY(-50%); font-size: .72rem; color: var(--muted); background: #fff; border: 1px solid var(--line); border-radius: 5px; padding: 1px 6px; pointer-events: none; }
  .gd-search input:focus ~ kbd, .gd-search input:not(:placeholder-shown) ~ kbd { display: none; }

  .seg { display: inline-flex; background: var(--wash); border-radius: 10px; padding: 3px; gap: 2px; }
  .seg button { border: 0; background: transparent; border-radius: 8px; padding: .42rem .8rem; font-size: .84rem; font-weight: 600; color: var(--muted); display: inline-flex; align-items: center; gap: .4rem; }
  .seg button em { font-style: normal; font-weight: 500; font-size: .78rem; opacity: .75; }
  .seg button[aria-pressed="true"] { background: #fff; color: var(--teal); box-shadow: 0 1px 4px rgba(15,37,48,.12); }
  .seg button:not([aria-pressed="true"]):hover { color: var(--teal); }
  .gd-count { margin-left: auto; font-size: .84rem; color: var(--muted); }

  /* Table */
  .gd-table { background: #fff; border: 1px solid var(--line); border-top: 0; border-radius: 0 0 14px 14px; overflow: hidden; }
  .gd table { margin: 0; width: 100%; border-collapse: collapse; }
  .gd thead th { background: var(--wash); font-size: .8rem; font-weight: 600; color: var(--muted); padding: .7rem 1rem; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
  .gd tbody td { padding: .8rem 1rem; border-top: 1px solid var(--line); vertical-align: middle; }
  .gd tbody tr:first-child td { border-top: 0; }
  .gd tbody tr:hover { background: rgba(14,105,123,.04); }
  .gd tbody tr.is-dup { background: rgba(194,37,92,.035); }

  .who { display: flex; align-items: center; gap: .8rem; min-width: 0; }
  .av { width: 38px; height: 38px; border-radius: 50%; background: var(--soft); color: var(--teal); font-weight: 700; display: grid; place-items: center; flex: none; }
  .who b { display: block; font-weight: 600; font-size: .95rem; }
  .who small { display: block; color: var(--muted); font-size: .8rem; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .86rem; }

  .pass { display: inline-block; padding: .2rem .65rem; border-radius: 999px; font-size: .78rem; font-weight: 600; background: var(--soft); color: var(--teal); }
  .pass.dbl { background: var(--delle-gold-soft, rgba(229,160,0,.14)); color: #8a5f00; }

  .st { display: inline-flex; align-items: center; gap: .4rem; font-size: .84rem; font-weight: 600; white-space: nowrap; }
  .st::before { content: ''; width: 9px; height: 9px; border-radius: 50%; border: 2px solid #9fb0b8; }
  .st.in { color: var(--ok); } .st.in::before { background: var(--ok); border-color: var(--ok); }
  .st.dup { color: var(--bad); } .st.dup::before { background: var(--bad); border-color: var(--bad); }
  .st.none { color: var(--muted); font-weight: 500; }

  .ib { width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line); background: #fff; color: var(--muted); display: inline-grid; place-items: center; font-size: 1.2rem; text-decoration: none; transition: background .15s, color .15s, border-color .15s; }
  .ib:hover { background: var(--teal); border-color: var(--teal); color: #fff; }

  /* Empty states */
  .gd-empty { display: none; text-align: center; padding: 3rem 1.5rem; border-top: 1px solid var(--line); }
  .gd-empty.show { display: block; }
  .gd-empty .ic { width: 60px; height: 60px; border-radius: 50%; background: var(--soft); color: var(--teal); display: grid; place-items: center; font-size: 1.8rem; margin: 0 auto .8rem; }
  .gd-empty h2 { font-size: 1.15rem; margin: 0 0 .3rem; } .gd-empty p { color: var(--muted); margin: 0 auto 1.1rem; max-width: 380px; font-size: .92rem; }
  .gd-blank { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 3.5rem 1.5rem; text-align: center; }
  .gd-blank .ic { width: 72px; height: 72px; border-radius: 50%; background: var(--delle-gold-soft, rgba(229,160,0,.14)); color: #8a5f00; display: grid; place-items: center; font-size: 2.2rem; margin: 0 auto 1rem; }
  .gd-blank h2 { font-size: 1.45rem; color: var(--teal-deep); } .gd-blank p { color: var(--muted); max-width: 420px; margin: .4rem auto 1.4rem; }

  @media (max-width: 767px) {
    .gd-sum { grid-template-columns: 1fr 1fr; row-gap: 1rem; }
    .gd-sum > div:nth-child(3) { border-left: 0; padding-left: .2rem; }
    .gd-search { max-width: none; } .gd-count { margin-left: 0; width: 100%; }
    .gd tbody td, .gd thead th { padding-left: .75rem; padding-right: .75rem; }
    .gd-bar { padding: .8rem; } .seg { max-width: 100%; overflow-x: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .gd * { transition: none !important; } }
</style>

<div class="gd">

  <header class="gd-head">
    <div>
      <h1 class="serif">Guests</h1>
      <p><%= event.title %></p>
    </div>
    <a href="/events/<%= event.id %>/guests/upload" class="btn-gd <%= total === 0 ? 'primary' : 'ghost' %>">
      <i class="bx bx-cloud-upload fs-5"></i> Import guests
    </a>
  </header>

  <% if (total === 0) { %>
    <section class="gd-blank">
      <div class="ic"><i class="bx bx-user-plus"></i></div>
      <h2 class="serif">No guests yet</h2>
      <p>Import your guest list from a CSV file. Each guest gets a personal invitation with their own entry code.</p>
      <a href="/events/<%= event.id %>/guests/upload" class="btn-gd primary"><i class="bx bx-cloud-upload fs-5"></i> Import guests</a>
    </section>
  <% } else { %>

  <section class="gd-sum" aria-label="Guest summary">
    <div><b><%= total %></b><span>Guests</span></div>
    <div><b><%= nSingle %><small class="text-muted fw-normal fs-5"> / <%= nDouble %></small></b><span>Single / double passes</span></div>
    <div class="ok"><b><%= nArrived %></b><span>Checked in</span></div>
    <div class="<%= nDup > 0 ? 'bad' : 'zero' %>"><b><%= nDup %></b><span>Duplicate scans</span></div>
  </section>

  <!-- Toolbar -->
  <div class="gd-bar">
    <div class="gd-search">
      <i class="bx bx-search"></i>
      <input type="text" id="searchInput" placeholder="Search name, phone or card number" aria-label="Search guests" autocomplete="off">
      <kbd>/</kbd>
    </div>

    <div class="seg" role="group" aria-label="Filter by pass type" id="typeSeg">
      <button type="button" data-type="ALL" aria-pressed="true">All <em><%= total %></em></button>
      <button type="button" data-type="SINGLE" aria-pressed="false">Single <em><%= nSingle %></em></button>
      <button type="button" data-type="DOUBLE" aria-pressed="false">Double <em><%= nDouble %></em></button>
    </div>

    <div class="seg" role="group" aria-label="Filter by check-in status" id="statusSeg">
      <button type="button" data-status="all" aria-pressed="true">Any status</button>
      <button type="button" data-status="pending" aria-pressed="false">Not arrived <em><%= nPending %></em></button>
      <button type="button" data-status="arrived" aria-pressed="false">Arrived <em><%= nArrived %></em></button>
      <button type="button" data-status="dup" aria-pressed="false">Duplicates <em><%= nDup %></em></button>
    </div>

    <div class="gd-count" id="resultCount" aria-live="polite">Showing <%= total %> of <%= total %></div>
  </div>

  <!-- Table -->
  <div class="gd-table">
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Guest</th>
            <th class="d-none d-md-table-cell">Pass</th>
            <th class="d-none d-lg-table-cell">Phone</th>
            <th class="d-none d-lg-table-cell">Card number</th>
            <th>Status</th>
            <th class="text-end"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody id="attendeesTable">
          <% guests.forEach(g => {
               const s = scansOf(g);
               const isDouble = up(g.type).includes('DOUBLE');
               const status = s === 0 ? 'pending' : (s === 1 ? 'arrived' : 'arrived dup');
               const hay = [g.name, g.phone, g.card_number, g.type].filter(Boolean).join(' ').toLowerCase();
          %>
            <tr class="guest-row<%= s > 1 ? ' is-dup' : '' %>" data-search="<%= hay %>" data-type="<%= up(g.type) %>" data-status="<%= status %>">
              <td>
                <div class="who">
                  <div class="av" aria-hidden="true"><%= g.name ? g.name.charAt(0).toUpperCase() : 'G' %></div>
                  <div>
                    <b><%= g.name %></b>
                    <small class="d-lg-none">
                      <%= [g.type, g.phone, g.card_number].filter(Boolean).join(' · ') %>
                    </small>
                  </div>
                </div>
              </td>
              <td class="d-none d-md-table-cell"><span class="pass<%= isDouble ? ' dbl' : '' %>"><%= g.type || '—' %></span></td>
              <td class="d-none d-lg-table-cell mono text-secondary"><%= g.phone || '—' %></td>
              <td class="d-none d-lg-table-cell mono fw-semibold"><%= g.card_number || '—' %></td>
              <td>
                <% if (s === 0) { %>
                  <span class="st none">Not arrived</span>
                <% } else if (s === 1) { %>
                  <span class="st in">Checked in</span>
                <% } else { %>
                  <span class="st dup" title="This pass was scanned <%= s %> times"><%= s %> scans</span>
                <% } %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-2">
                  <a href="/events/<%= event.id %>/guests/<%= g.id %>/edit" class="ib" title="Edit guest" aria-label="Edit <%= g.name %>"><i class="bx bx-edit-alt"></i></a>
                  <a href="/events/<%= event.id %>/guests/<%= g.id %>/download" class="ib" title="Download invitation" aria-label="Download invitation for <%= g.name %>"><i class="bx bx-download"></i></a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div id="noResults" class="gd-empty">
      <div class="ic"><i class="bx bx-search-alt"></i></div>
      <h2 class="serif">No guests found</h2>
      <p>Nothing matches your search and filters. Try a different spelling or clear the filters.</p>
      <button type="button" class="btn-gd ghost" id="clearFilters">Clear filters</button>
    </div>
  </div>

  <% } %>
</div>

<script>
  (function () {
    const input = document.getElementById('searchInput');
    if (!input) return;

    const rows = [...document.querySelectorAll('#attendeesTable tr.guest-row')];
    const state = { q: '', type: 'ALL', status: 'all' };

    function apply() {
      let shown = 0;
      rows.forEach(r => {
        const ok = (!state.q || r.dataset.search.includes(state.q))
          && (state.type === 'ALL' || r.dataset.type.includes(state.type))
          && (state.status === 'all' || r.dataset.status.split(' ').includes(state.status));
        r.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      document.getElementById('noResults').classList.toggle('show', shown === 0);
      document.getElementById('resultCount').textContent = 'Showing ' + shown + ' of ' + rows.length;
    }

    function press(group, btn) {
      group.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', b === btn));
    }

    input.addEventListener('input', () => { state.q = input.value.trim().toLowerCase(); apply(); });

    const typeSeg = document.getElementById('typeSeg'), statusSeg = document.getElementById('statusSeg');
    typeSeg.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; state.type = b.dataset.type; press(typeSeg, b); apply(); });
    statusSeg.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; state.status = b.dataset.status; press(statusSeg, b); apply(); });

    document.getElementById('clearFilters').addEventListener('click', () => {
      input.value = ''; state.q = ''; state.type = 'ALL'; state.status = 'all';
      press(typeSeg, typeSeg.querySelector('[data-type="ALL"]'));
      press(statusSeg, statusSeg.querySelector('[data-status="all"]'));
      apply(); input.focus();
    });

    // Press "/" anywhere to jump to search
    document.addEventListener('keydown', e => {
      if (e.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) { e.preventDefault(); input.focus(); }
    });
  })();
</script>
