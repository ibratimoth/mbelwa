<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#073a4a">
  <title>Sign in | Delle Cards</title>

  <link rel="icon" type="image/jpeg" href="/images/delleventures.jpeg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <style>
    :root {
      --delle-teal: #0e697b; --delle-teal-hover: #0a5160; --delle-teal-deep: #073a4a; --delle-teal-soft: rgba(14,105,123,.08);
      --delle-gold: #e5a000; --delle-gold-soft: rgba(229,160,0,.14);
      --ink: #0f2530; --muted: #5d7079; --line: rgba(15,37,48,.14); --wash: #f4f7f8;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: var(--ink); background: #fff; -webkit-font-smoothing: antialiased; }
    .serif { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -.015em; }
    :focus-visible { outline: 3px solid var(--delle-gold); outline-offset: 2px; }

    .auth { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }

    /* ---------- Brand panel ---------- */
    .hero { position: relative; overflow: hidden; background: linear-gradient(145deg, var(--delle-teal-deep) 0%, var(--delle-teal) 100%); color: #fff; padding: 3rem 3.5rem; display: flex; flex-direction: column; }
    .hero::before, .hero::after { content: ''; position: absolute; border-radius: 50%; pointer-events: none; border: 1px solid rgba(229,160,0,.32); }
    .hero::before { width: 520px; height: 520px; right: -170px; bottom: -190px; box-shadow: 0 0 0 48px rgba(229,160,0,.045), 0 0 0 104px rgba(229,160,0,.03); }
    .hero::after { width: 200px; height: 200px; left: -70px; top: 38%; border-color: rgba(255,255,255,.12); }
    .brand { display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; position: relative; z-index: 2; }
    .brand img { width: 42px; height: 42px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(255,255,255,.3); }
    .brand .w { font-size: 1.45rem; color: #fff; } .brand .w span { color: var(--delle-gold); }

    .hero-main { margin: auto 0; padding: 2.5rem 0; position: relative; z-index: 2; display: grid; gap: 2.5rem; max-width: 520px; }
    .hero h1 { font-size: clamp(2rem, 3.2vw, 2.9rem); line-height: 1.1; margin: 0 0 1rem; color: #fff; }
    .hero p.lead { color: rgba(255,255,255,.8); font-size: 1.02rem; line-height: 1.6; margin: 0; max-width: 440px; }
    .points { list-style: none; padding: 0; margin: 1.6rem 0 0; display: grid; gap: .75rem; }
    .points li { display: flex; align-items: center; gap: .75rem; font-size: .94rem; color: rgba(255,255,255,.9); }
    .points i { width: 32px; height: 32px; border-radius: 9px; background: rgba(255,255,255,.12); color: var(--delle-gold); display: grid; place-items: center; font-size: 1.1rem; flex: none; }

    /* Invitation mock-up */
    .mock { position: relative; height: 250px; max-width: 420px; }
    .inv { position: absolute; left: 0; top: 0; width: 210px; background: #fff; color: var(--ink); border-radius: 16px; padding: 1.1rem 1.1rem 1rem; transform: rotate(-4deg); box-shadow: 0 24px 50px rgba(0,0,0,.35); animation: float 7s ease-in-out infinite; }
    .inv small { display: block; color: var(--muted); font-size: .68rem; }
    .inv .nm { font-size: 1.2rem; line-height: 1.15; color: var(--delle-teal-deep); margin: .4rem 0 .15rem; }
    .inv .rule { height: 2px; width: 34px; background: var(--delle-gold); margin: .5rem 0 .7rem; border-radius: 2px; }
    .inv svg { width: 76px; height: 76px; display: block; }
    .tick { position: absolute; right: 0; bottom: 18px; background: #fff; color: var(--ink); border-radius: 14px; padding: .75rem 1rem; display: flex; align-items: center; gap: .7rem; box-shadow: 0 20px 44px rgba(0,0,0,.3); animation: float 7s ease-in-out -3s infinite; }
    .tick .ok { width: 34px; height: 34px; border-radius: 50%; background: rgba(25,135,84,.12); color: #198754; display: grid; place-items: center; font-size: 1.3rem; }
    .tick b { display: block; font-size: .86rem; } .tick span { font-size: .75rem; color: var(--muted); }
    @keyframes float { 50% { translate: 0 -8px; } }

    .hero-foot { position: relative; z-index: 2; font-size: .82rem; color: rgba(255,255,255,.6); }

    /* ---------- Form panel ---------- */
    .panel { display: flex; flex-direction: column; justify-content: center; padding: 3rem 2rem; position: relative; }
    .panel-in { width: 100%; max-width: 410px; margin: 0 auto; }
    .m-brand { display: none; margin-bottom: 2rem; }
    .m-brand .w { font-size: 1.4rem; color: var(--delle-teal); } .m-brand .w span { color: var(--delle-gold); }
    .m-brand img { width: 40px; height: 40px; border-radius: 11px; object-fit: cover; border: 1px solid var(--line); }

    .panel h2 { font-size: 2rem; margin: 0 0 .4rem; color: var(--delle-teal-deep); }
    .panel .sub { color: var(--muted); margin: 0 0 1.75rem; }

    .alert-x { display: flex; gap: .6rem; align-items: flex-start; background: rgba(194,37,92,.08); color: #8c1d46; border-radius: 12px; padding: .8rem 1rem; font-size: .9rem; font-weight: 500; margin-bottom: 1.25rem; }
    .alert-x i { font-size: 1.25rem; flex: none; margin-top: 1px; }

    .fld { margin-bottom: 1.1rem; }
    .fld label { display: block; font-size: .86rem; font-weight: 600; margin-bottom: .4rem; }
    .inp { position: relative; }
    .inp > i.lead-ic { position: absolute; left: .95rem; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 1.2rem; pointer-events: none; }
    .inp input { width: 100%; height: 52px; border: 1.5px solid var(--line); border-radius: 12px; padding: 0 3rem 0 2.8rem; font-size: .98rem; background: #fff; color: var(--ink); transition: border-color .15s, box-shadow .15s; }
    .inp input::placeholder { color: #93a3ab; }
    .inp input:hover { border-color: rgba(14,105,123,.45); }
    .inp input:focus { outline: 0; border-color: var(--delle-teal); box-shadow: 0 0 0 4px rgba(14,105,123,.15); }
    .eye { position: absolute; right: .35rem; top: 50%; transform: translateY(-50%); width: 42px; height: 42px; border: 0; background: transparent; color: var(--muted); border-radius: 10px; font-size: 1.3rem; display: grid; place-items: center; }
    .eye:hover { background: var(--delle-teal-soft); color: var(--delle-teal); }
    .caps { display: none; align-items: center; gap: .35rem; font-size: .8rem; color: #8a5f00; margin-top: .4rem; font-weight: 600; }
    .caps.on { display: flex; }

    .btn-go { width: 100%; height: 54px; margin-top: .6rem; border: 0; border-radius: 12px; background: var(--delle-teal); color: #fff; font-weight: 700; font-size: 1rem; display: inline-flex; align-items: center; justify-content: center; gap: .6rem; transition: background .15s, box-shadow .15s; }
    .btn-go:hover:not(:disabled) { background: var(--delle-teal-hover); box-shadow: 0 10px 24px rgba(14,105,123,.28); }
    .btn-go:disabled { opacity: .75; cursor: progress; }
    .btn-go i { font-size: 1.3rem; transition: transform .2s; } .btn-go:hover:not(:disabled) i { transform: translateX(3px); }

    .alt { margin-top: 1.75rem; padding-top: 1.4rem; border-top: 1px solid var(--line); text-align: center; color: var(--muted); font-size: .92rem; }
    .alt a { color: var(--delle-teal); font-weight: 700; text-decoration: none; margin-left: .3rem; } .alt a:hover { text-decoration: underline; }
    .secure { display: flex; align-items: center; justify-content: center; gap: .4rem; margin-top: 1.1rem; font-size: .8rem; color: var(--muted); }
    .secure i { color: var(--delle-teal); }

    @media (max-width: 991.98px) {
      .auth { grid-template-columns: 1fr; }
      .hero { display: none; }
      .m-brand { display: inline-flex; }
      .panel { min-height: 100vh; padding: 2rem 1.4rem; }
      .panel::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 6px; background: linear-gradient(90deg, var(--delle-teal-deep), var(--delle-teal), var(--delle-gold)); }
    }
    @media (prefers-reduced-motion: reduce) { .inv, .tick { animation: none; } * { transition: none !important; } }
  </style>
</head>

<body>
  <div class="auth">

    <!-- Brand panel -->
    <aside class="hero" aria-hidden="false">
      <a href="/" class="brand" aria-label="Delle Cards">
        <img src="/images/delleventures.jpeg" alt="">
        <span class="w serif">Delle<span>Cards</span></span>
      </a>

      <div class="hero-main">
        <div>
          <h1 class="serif">Welcome every guest beautifully.</h1>
          <p class="lead">Send personal invitations, then check guests in at the door. All from one place.</p>
          <ul class="points">
            <li><i class="bx bx-message-square-dots"></i> Invite by SMS and WhatsApp</li>
            <li><i class="bx bx-qr-scan"></i> Check guests in with a QR scan</li>
            <li><i class="bx bx-shield-quarter"></i> Catch duplicate entries instantly</li>
          </ul>
        </div>

        <div class="mock" aria-hidden="true">
          <div class="inv">
            <small>You are invited</small>
            <div class="nm serif">Your names<br>go here</div>
            <div class="rule"></div>
            <svg viewBox="0 0 21 21" shape-rendering="crispEdges" fill="#073a4a">
              <path d="M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0z"/>
              <path fill="#fff" d="M1 1h5v5H1zM15 1h5v5h-5zM1 15h5v5H1z"/>
              <path d="M2 2h3v3H2zM16 2h3v3h-3zM2 16h3v3H2z"/>
              <path d="M8 1h2v2H8zM10 4h2v2h-2zM8 8h2v2H8zM12 8h3v2h-3zM16 9h2v2h-2zM9 11h2v3H9zM12 12h2v2h-2zM15 14h3v2h-3zM8 16h2v2H8zM11 17h3v2h-3zM18 17h2v3h-2zM13 15h1v1h-1z"/>
            </svg>
          </div>
          <div class="tick">
            <div class="ok"><i class="bx bx-check"></i></div>
            <div><b>Checked in</b><span>Welcome, table 4</span></div>
          </div>
        </div>
      </div>

      <div class="hero-foot">&copy; <%= new Date().getFullYear() %> Delle Ventures</div>
    </aside>

    <!-- Form panel -->
    <main class="panel">
      <div class="panel-in">

        <a href="/" class="brand m-brand" aria-label="Delle Cards">
          <img src="/images/delleventures.jpeg" alt="">
          <span class="w serif">Delle<span>Cards</span></span>
        </a>

        <h2 class="serif">Welcome back</h2>
        <p class="sub">Sign in to manage your events and guests.</p>

        <div id="errorAlertContainer" aria-live="assertive">
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-x" role="alert"><i class="bx bx-error-circle"></i><span id="errorText"><%= error %></span></div>
          <% } %>
        </div>

        <form id="loginForm" action="/login" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="fld">
            <label for="emailInput">Email address</label>
            <div class="inp">
              <i class="bx bx-envelope lead-ic"></i>
              <input type="email" name="email" id="emailInput" value="<%= typeof email !== 'undefined' ? email : '' %>"
                required placeholder="name@company.com" autocomplete="email" autofocus>
            </div>
          </div>

          <div class="fld">
            <label for="passwordInput">Password</label>
            <div class="inp">
              <i class="bx bx-lock-alt lead-ic"></i>
              <input type="password" name="password" id="passwordInput" required placeholder="Enter your password" autocomplete="current-password">
              <button type="button" class="eye" id="togglePasswordBtn" aria-label="Show password" aria-pressed="false">
                <i class="bx bx-hide" id="togglePasswordIcon"></i>
              </button>
            </div>
            <div class="caps" id="capsHint"><i class="bx bx-up-arrow-alt"></i> Caps Lock is on</div>
          </div>

          <button type="submit" id="submitBtn" class="btn-go">
            <span id="btnText">Sign in</span>
            <i class="bx bx-right-arrow-alt" id="btnIcon"></i>
            <span class="spinner-border spinner-border-sm d-none" id="btnSpin"></span>
          </button>
        </form>

        <div class="alt">New to Delle Cards?<a href="/register">Create an account</a></div>
        <div class="secure"><i class="bx bx-lock-alt"></i> Your connection is private and encrypted</div>
      </div>
    </main>
  </div>

  <script>
    (function () {
      const $ = id => document.getElementById(id);
      const form = $('loginForm'), pw = $('passwordInput'), box = $('errorAlertContainer');

      /* Show / hide password */
      $('togglePasswordBtn').addEventListener('click', function () {
        const show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        this.setAttribute('aria-pressed', show);
        this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        $('togglePasswordIcon').className = 'bx ' + (show ? 'bx-show' : 'bx-hide');
      });

      /* Caps Lock hint */
      const caps = e => $('capsHint').classList.toggle('on', e.getModifierState && e.getModifierState('CapsLock'));
      pw.addEventListener('keydown', caps); pw.addEventListener('keyup', caps);
      pw.addEventListener('blur', () => $('capsHint').classList.remove('on'));

      function showError(msg) {
        box.innerHTML = '';
        const d = document.createElement('div'); d.className = 'alert-x'; d.setAttribute('role', 'alert');
        d.innerHTML = '<i class="bx bx-error-circle"></i>';
        const s = document.createElement('span'); s.textContent = msg; d.appendChild(s);
        box.appendChild(d);
      }

      function setLoading(on) {
        $('submitBtn').disabled = on;
        $('btnText').textContent = on ? 'Signing in…' : 'Sign in';
        $('btnIcon').classList.toggle('d-none', on);
        $('btnSpin').classList.toggle('d-none', !on);
      }

      /* Submit with fetch so rate-limit (429) and wrong-password messages show without a page reload.
         The request is sent once: no fallback re-submit, so a failed attempt is never counted twice. */
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;

        box.innerHTML = '';
        setLoading(true);
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;

        try {
          const res = await fetch('/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'CSRF-Token': csrf },
            body: new URLSearchParams(new FormData(form)).toString()
          });

          // Successful sign-in (or a redirect back to /login with a flash message)
          if (res.redirected) { window.location.href = res.url; return; }

          let message = '';
          const type = res.headers.get('content-type') || '';
          if (type.includes('application/json')) {
            const data = await res.json().catch(() => ({}));
            message = data.error || data.message || '';
          } else {
            // The server re-rendered this page with an error: read it from the returned HTML
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            message = doc.getElementById('errorText')?.textContent.trim() || '';
          }
          if (!message) message = res.status === 429 ? 'Too many attempts. Please try again later.' : 'Sign in failed. Check your email and password.';

          showError(message);
          pw.value = ''; pw.focus();
        } catch (err) {
          console.error(err);
          showError('We could not reach the server. Check your connection and try again.');
        } finally {
          setLoading(false);
        }
      });
    })();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
