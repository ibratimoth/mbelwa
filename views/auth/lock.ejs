<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#073a4a">
  <title>Session locked | Delle Cards</title>

  <link rel="icon" type="image/jpeg" href="/images/delleventures.jpeg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <style>
    :root {
      --delle-teal: #0e697b; --delle-teal-hover: #0a5160; --delle-teal-deep: #073a4a; --delle-teal-soft: rgba(14,105,123,.08);
      --delle-gold: #e5a000; --delle-gold-soft: rgba(229,160,0,.14);
      --ink: #0f2530; --muted: #5d7079; --line: rgba(15,37,48,.14);
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: var(--ink); -webkit-font-smoothing: antialiased;
           background: linear-gradient(160deg, var(--delle-teal-deep) 0%, var(--delle-teal) 100%); position: relative; overflow-x: hidden; }
    .serif { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -.015em; }
    :focus-visible { outline: 3px solid var(--delle-gold); outline-offset: 2px; }

    /* Background rings */
    body::before, body::after { content: ''; position: fixed; border-radius: 50%; pointer-events: none; border: 1px solid rgba(229,160,0,.3); }
    body::before { width: 640px; height: 640px; right: -220px; bottom: -260px; box-shadow: 0 0 0 56px rgba(229,160,0,.04), 0 0 0 120px rgba(229,160,0,.025); }
    body::after { width: 280px; height: 280px; left: -100px; top: 20%; border-color: rgba(255,255,255,.1); }

    .screen { position: relative; z-index: 1; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 1.6rem 1.25rem 1.5rem; }
    .brand { align-self: flex-start; display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; }
    .brand img { width: 38px; height: 38px; border-radius: 11px; object-fit: cover; border: 1px solid rgba(255,255,255,.3); }
    .brand .w { font-size: 1.35rem; color: #fff; } .brand .w span { color: var(--delle-gold); }

    /* Clock */
    .clock { text-align: center; color: #fff; margin: 2.2rem 0 1.8rem; }
    .clock .t { font-size: clamp(3.2rem, 8vw, 5rem); line-height: 1; font-variant-numeric: tabular-nums; }
    .clock .d { color: rgba(255,255,255,.75); font-size: 1rem; margin-top: .5rem; }

    /* Card */
    .card-lock { width: 100%; max-width: 410px; background: #fff; border-radius: 24px; padding: 2rem 1.9rem 1.6rem; box-shadow: 0 30px 80px rgba(3,28,38,.45); text-align: center; position: relative; }
    .card-lock::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 5px; border-radius: 24px 24px 0 0; background: linear-gradient(90deg, var(--delle-teal-deep), var(--delle-teal), var(--delle-gold)); }

    .av { position: relative; width: 78px; height: 78px; margin: 0 auto 1rem; }
    .av .face { width: 100%; height: 100%; border-radius: 50%; background: var(--delle-teal); color: #fff; display: grid; place-items: center; font-size: 2rem; font-weight: 700; box-shadow: 0 0 0 5px var(--delle-teal-soft); }
    .av .lk { position: absolute; right: -4px; bottom: -2px; width: 30px; height: 30px; border-radius: 50%; background: var(--delle-gold); color: #1d1500; display: grid; place-items: center; font-size: 1rem; border: 3px solid #fff; }

    .card-lock h1 { font-size: 1.55rem; margin: 0 0 .15rem; color: var(--delle-teal-deep); word-break: break-word; }
    .card-lock .mail { color: var(--muted); font-size: .88rem; word-break: break-all; }
    .why { display: inline-flex; align-items: center; gap: .4rem; background: var(--delle-gold-soft); color: #8a5f00; font-size: .8rem; font-weight: 600; padding: .28rem .8rem; border-radius: 999px; margin: .9rem 0 1.4rem; }

    .alert-x { display: flex; gap: .6rem; align-items: flex-start; background: rgba(194,37,92,.08); color: #8c1d46; border-radius: 12px; padding: .75rem 1rem; font-size: .88rem; font-weight: 500; margin-bottom: 1rem; text-align: left; }
    .alert-x i { font-size: 1.2rem; flex: none; margin-top: 1px; }

    .fld { text-align: left; margin-bottom: 1rem; }
    .fld label { display: block; font-size: .86rem; font-weight: 600; margin-bottom: .4rem; }
    .inp { position: relative; }
    .inp > i.lead-ic { position: absolute; left: .95rem; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 1.2rem; pointer-events: none; }
    .inp input { width: 100%; height: 52px; border: 1.5px solid var(--line); border-radius: 12px; padding: 0 3rem 0 2.8rem; font-size: .98rem; background: #fff; color: var(--ink); transition: border-color .15s, box-shadow .15s; }
    .inp input::placeholder { color: #93a3ab; }
    .inp input:hover { border-color: rgba(14,105,123,.45); }
    .inp input:focus { outline: 0; border-color: var(--delle-teal); box-shadow: 0 0 0 4px rgba(14,105,123,.15); }
    .eye { position: absolute; right: .35rem; top: 50%; transform: translateY(-50%); width: 42px; height: 42px; border: 0; background: transparent; color: var(--muted); border-radius: 10px; font-size: 1.3rem; display: grid; place-items: center; }
    .eye:hover { background: var(--delle-teal-soft); color: var(--delle-teal); }
    .caps { display: none; align-items: center; gap: .35rem; font-size: .8rem; color: #8a5f00; margin-top: .4rem; font-weight: 600; }
    .caps.on { display: flex; }

    .btn-go { width: 100%; height: 54px; border: 0; border-radius: 12px; background: var(--delle-teal); color: #fff; font-weight: 700; font-size: 1rem; display: inline-flex; align-items: center; justify-content: center; gap: .6rem; transition: background .15s, box-shadow .15s; }
    .btn-go:hover:not(:disabled) { background: var(--delle-teal-hover); box-shadow: 0 10px 24px rgba(14,105,123,.28); }
    .btn-go:disabled { opacity: .75; cursor: progress; }

    .alt { margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
    .alt a { color: var(--delle-teal); font-weight: 700; text-decoration: none; margin-left: .25rem; } .alt a:hover { text-decoration: underline; }

    .note { margin-top: auto; padding-top: 1.6rem; color: rgba(255,255,255,.7); font-size: .82rem; text-align: center; display: flex; align-items: center; gap: .4rem; justify-content: center; }
    .note i { color: var(--delle-gold); }

    @media (max-width: 575px) { .brand { align-self: center; } .card-lock { padding: 1.7rem 1.3rem 1.4rem; } }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</head>

<body>
  <div class="screen">

    <a href="/" class="brand" aria-label="Delle Cards">
      <img src="/images/delleventures.jpeg" alt="">
      <span class="w serif">Delle<span>Cards</span></span>
    </a>

    <div class="clock" aria-hidden="true">
      <div class="t serif" id="clockTime">--:--</div>
      <div class="d" id="clockDate"></div>
    </div>

    <main class="card-lock">
      <div class="av">
        <div class="face"><%= (typeof user !== 'undefined' && user && user.name) ? user.name.charAt(0).toUpperCase() : 'U' %></div>
        <div class="lk"><i class="bx bx-lock-alt"></i></div>
      </div>

<h1 class="serif"><%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Welcome back' %></h1>
<div class="why"><i class="bx bx-time-five"></i> Locked after a period of inactivity</div>

      <div id="errorAlertContainer" aria-live="assertive">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert-x" role="alert"><i class="bx bx-error-circle"></i><span id="errorText"><%= error %></span></div>
        <% } %>
      </div>

      <form action="/unlock" method="POST" id="unlockForm" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="fld">
          <label for="passwordInput">Enter your password to continue</label>
          <div class="inp">
            <i class="bx bx-lock-alt lead-ic"></i>
            <input type="password" name="password" id="passwordInput" required placeholder="Your password" autocomplete="current-password" autofocus>
            <button type="button" class="eye" id="togglePasswordBtn" aria-label="Show password" aria-pressed="false">
              <i class="bx bx-hide" id="togglePasswordIcon"></i>
            </button>
          </div>
          <div class="caps" id="capsHint"><i class="bx bx-up-arrow-alt"></i> Caps Lock is on</div>
        </div>

        <button type="submit" id="submitBtn" class="btn-go">
          <i class="bx bx-lock-open-alt fs-5" id="btnIcon"></i>
          <span id="btnText">Unlock session</span>
          <span class="spinner-border spinner-border-sm d-none" id="btnSpin"></span>
        </button>
      </form>

      <div class="alt">
    Not you? 
    <form action="/logout" method="POST" style="display:inline; margin:0;">
        <button type="submit" style="background:none; border:none; color:inherit; text-decoration:underline; cursor:pointer; font:inherit; padding:0;">Sign in with a different account</button>
    </form>
</div>
    </main>

    <div class="note"><i class="bx bx-shield-check"></i> Your guest lists and event work are safe while you are away.</div>
  </div>

  <script>
    (function () {
      const $ = id => document.getElementById(id);
      const form = $('unlockForm'), pw = $('passwordInput'), box = $('errorAlertContainer');

      /* Clock */
      function tickClock() {
        const now = new Date();
        $('clockTime').textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        $('clockDate').textContent = now.toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long' });
      }
      tickClock(); setInterval(tickClock, 10000);

      /* Show / hide password */
      $('togglePasswordBtn').addEventListener('click', function () {
        const show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        this.setAttribute('aria-pressed', show);
        this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        $('togglePasswordIcon').className = 'bx ' + (show ? 'bx-show' : 'bx-hide');
      });

      /* Caps Lock hint */
      const caps = e => $('capsHint').classList.toggle('on', e.getModifierState && e.getModifierState('CapsLock'));
      pw.addEventListener('keydown', caps); pw.addEventListener('keyup', caps);
      pw.addEventListener('blur', () => $('capsHint').classList.remove('on'));

      function showError(msg) {
        box.innerHTML = '';
        const d = document.createElement('div'); d.className = 'alert-x'; d.setAttribute('role', 'alert');
        d.innerHTML = '<i class="bx bx-error-circle"></i>';
        const s = document.createElement('span'); s.textContent = msg; d.appendChild(s);
        box.appendChild(d);
      }
      function setLoading(on) {
        $('submitBtn').disabled = on;
        $('btnText').textContent = on ? 'Unlocking…' : 'Unlock session';
        $('btnIcon').classList.toggle('d-none', on);
        $('btnSpin').classList.toggle('d-none', !on);
      }

      /* Sent once with fetch so wrong-password and rate-limit messages appear in place.
         No fallback re-submit: a failed attempt is never counted twice. */
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (!pw.value) { showError('Enter your password to continue.'); pw.focus(); return; }

        box.innerHTML = '';
        setLoading(true);
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;

        try {
          const res = await fetch('/unlock', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'CSRF-Token': csrf },
            body: new URLSearchParams(new FormData(form)).toString()
          });

          if (res.redirected) { window.location.href = res.url; return; }

          let message = '';
          const type = res.headers.get('content-type') || '';
          if (type.includes('application/json')) {
            const data = await res.json().catch(() => ({}));
            message = data.error || data.message || '';
          } else {
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            message = doc.getElementById('errorText')?.textContent.trim() || '';
          }
          if (!message) message = res.status === 429 ? 'Too many unlock attempts. Please try again later.' : 'That password is not correct. Please try again.';

          showError(message);
          pw.value = ''; pw.focus();
        } catch (err) {
          console.error(err);
          showError('We could not reach the server. Check your connection and try again.');
        } finally {
          setLoading(false);
        }
      });
    })();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
