<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Wedding Card Manager</title>

  <!-- Google Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <style>
    :root {
      --delle-teal: #0E6171;
      --delle-teal-hover: #0a4854;
      --delle-gold: #E0A21E;
      --delle-gold-hover: #c48c17;
      --delle-light-bg: #f8f9fa;
      --delle-dark: #212529;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--delle-light-bg);
      color: var(--delle-dark);
      padding-top: 85px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Branded Navbar */
    .navbar-branded {
      background-color: #ffffff;
      border-bottom: 2px solid var(--delle-teal);
    }

    .navbar-brand-text {
      color: var(--delle-teal);
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .navbar-brand-text span {
      color: var(--delle-gold);
    }

    /* System Buttons */
    .btn-delle-gold {
      background-color: var(--delle-gold);
      color: #ffffff;
      border: 1px solid var(--delle-gold);
      transition: all 0.2s ease-in-out;
    }

    .btn-delle-gold:hover {
      background-color: var(--delle-gold-hover);
      color: #ffffff;
    }

    .btn-delle-outline {
      background-color: transparent;
      color: var(--delle-teal);
      border: 1px solid var(--delle-teal);
      transition: all 0.2s ease-in-out;
    }

    .btn-delle-outline:hover {
      background-color: var(--delle-teal);
      color: #ffffff;
    }
  </style>
</head>

<body>

  <!-- Top Navbar -->
  <nav class="navbar navbar-expand-lg navbar-light fixed-top navbar-branded shadow-sm">
    <div class="container">
      <a href="/" class="navbar-brand d-flex align-items-center gap-2">
        <img src="/images/delleventures.jpeg" alt="Delle Logo" height="35" class="d-inline-block align-top rounded">
        <span class="navbar-brand-text mb-0 h6 fw-bold">Wedding<span>Manager</span></span>
      </a>

      <div class="ms-auto d-flex align-items-center gap-2">
        <a href="/login" class="btn btn-delle-outline btn-sm">Sign In</a>
      </div>
    </div>
  </nav>

  <!-- Register Main Content -->
  <main class="container my-auto py-5">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4 bg-white" style="border-top: 4px solid var(--delle-gold) !important;">
          
          <div class="text-center mb-4">
            <h4 class="fw-bold text-dark">Create Account</h4>
            <p class="text-muted small">Register to manage events and generate custom card invitations</p>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 small py-2 mb-3" role="alert">
              <i class="bx bx-error-circle fs-5"></i>
              <div><%= error %></div>
            </div>
          <% } %>

          <form action="/register" method="POST">
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Full Name</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bx bx-user"></i></span>
                <input type="text" name="name" class="form-control" value="<%= typeof name !== 'undefined' ? name : '' %>" required placeholder="John Doe">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Email Address</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bx bx-envelope"></i></span>
                <input type="email" name="email" class="form-control" value="<%= typeof email !== 'undefined' ? email : '' %>" required placeholder="name@example.com">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bx bx-lock-alt"></i></span>
                <input type="password" name="password" class="form-control" required placeholder="••••••••">
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label small fw-bold text-secondary">Confirm Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bx bx-check-shield"></i></span>
                <input type="password" name="confirm_password" class="form-control" required placeholder="••••••••">
              </div>
            </div>

            <button type="submit" class="btn btn-delle-gold w-100 py-2 fw-medium shadow-sm">
              Register Account
            </button>
          </form>

          <div class="text-center mt-4 pt-3 border-top">
            <p class="small text-muted mb-0">Already have an account? <a href="/login" class="fw-bold text-decoration-none" style="color: var(--delle-teal);">Sign in here</a></p>
          </div>

        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>