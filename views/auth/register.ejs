<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Create Account — Delle Cards</title>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 & Boxicons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <style>
    :root {
      --delle-teal: #0e697b;
      --delle-teal-dark: #073a4a;
      --delle-teal-soft: rgba(14, 105, 123, 0.08);
      --delle-gold: #e5a000;
      --delle-gold-hover: #c48c17;
      --delle-gold-soft: rgba(229, 160, 0, 0.12);
      --delle-dark-bg: #0b132b;
      --delle-light-bg: #f8fafc;
      --delle-border: rgba(15, 23, 42, 0.08);
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: var(--delle-light-bg);
      color: #0f172a;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* Main Container Shell */
    .auth-shell {
      width: 100%;
      min-height: 100vh;
      display: flex;
    }

    /* Left Showcase Hero Panel */
    .auth-hero-panel {
      background: linear-gradient(135deg, var(--delle-teal-dark) 0%, var(--delle-teal) 100%);
      color: #ffffff;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 3.5rem;
      position: relative;
      overflow: hidden;
    }

    .auth-hero-panel::after {
      content: '';
      position: absolute;
      right: -100px;
      bottom: -100px;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(229, 160, 0, 0.25) 0%, rgba(255,255,255,0) 70%);
      pointer-events: none;
    }

    .hero-feature-badge {
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      padding: 0.75rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      max-width: 420px;
    }

    /* Right Form Control Panel */
    .auth-form-panel {
      width: 100%;
      max-width: 540px;
      background: #ffffff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3.5rem 3rem;
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.02);
      overflow-y: auto;
    }

    /* Form Inputs Styling */
    .form-control {
      border: 1px solid var(--delle-border);
      padding: 0.75rem 1rem;
      border-radius: 10px;
      font-size: 0.925rem;
      transition: all 0.2s ease;
      background-color: #f8fafc;
    }

    .form-control:focus {
      background-color: #ffffff;
      border-color: var(--delle-teal);
      box-shadow: 0 0 0 4px var(--delle-teal-soft);
    }

    .input-group-text {
      background-color: #f8fafc;
      border: 1px solid var(--delle-border);
      border-right: none;
      color: #64748b;
      border-top-left-radius: 10px;
      border-bottom-left-radius: 10px;
    }

    .input-group .form-control {
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }

    /* Primary Gold Button */
    .btn-delle-gold {
      background-color: var(--delle-gold);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 0.85rem 1.5rem;
      transition: all 0.25s ease;
    }

    .btn-delle-gold:hover {
      background-color: var(--delle-gold-hover);
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(229, 160, 0, 0.3);
    }

    .password-toggle-btn {
      cursor: pointer;
      background-color: #f8fafc;
      border: 1px solid var(--delle-border);
      border-left: none;
      color: #64748b;
      border-top-right-radius: 10px;
      border-bottom-right-radius: 10px;
    }

    /* Responsive Mobile Adjustment */
    @media (max-width: 991.98px) {
      .auth-hero-panel {
        display: none;
      }
      .auth-form-panel {
        max-width: 100%;
        min-height: 100vh;
      }
    }
  </style>
</head>

<body>

  <div class="auth-shell">

    <!-- LEFT COLUMN: BRAND SHOWCASE HERO -->
    <div class="auth-hero-panel">
      <!-- Top Branding -->
      <div class="d-flex align-items-center gap-2.5">
        <img src="/images/delleventures.jpeg" alt="Delle Cards Logo" height="42" class="rounded-3 shadow-sm border border-white border-opacity-20">
        <span class="fs-4 fw-bold text-white tracking-tight">Delle<span style="color: var(--delle-gold);">Cards</span></span>
      </div>

      <!-- Hero Value Pitch -->
      <div class="my-auto py-5" style="z-index: 2; max-width: 480px;">
        <span class="badge rounded-pill bg-white bg-opacity-10 text-white px-3 py-1.5 fw-semibold mb-3 border border-white border-opacity-20">
          <i class="bx bx-star text-warning me-1"></i> Start Event Management
        </span>
        <h1 class="display-6 fw-bold text-white mb-3" style="line-height: 1.2;">
          Elevate Your Digital Invitations.
        </h1>
        <p class="fs-6 text-white-50 mb-4 fw-normal">
          Join planners and organizers using automated digital pass creation, bulk SMS & WhatsApp broadcasts, and high-speed door scanning.
        </p>

        <!-- Feature List Stack -->
        <div class="d-flex flex-column gap-2.5">
          <div class="hero-feature-badge shadow-sm">
            <div class="p-2 rounded-2 bg-warning bg-opacity-20 text-warning">
              <i class="bx bx-paper-plane fs-4"></i>
            </div>
            <div>
              <div class="fw-bold text-white fs-7">Multi-channel Distribution</div>
              <div class="text-white-50 fs-8">Automated SMS & WhatsApp guest delivery</div>
            </div>
          </div>

          <div class="hero-feature-badge shadow-sm">
            <div class="p-2 rounded-2 bg-info bg-opacity-20 text-info">
              <i class="bx bx-palette fs-4"></i>
            </div>
            <div>
              <div class="fw-bold text-white fs-7">Custom Card Editor</div>
              <div class="text-white-50 fs-8">Overlay dynamic QR codes onto high-res graphics</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Branding -->
      <div class="text-white-50 small" style="z-index: 2;">
        &copy; <%= new Date().getFullYear() %> Delle Ventures. All rights reserved.
      </div>
    </div>

    <!-- RIGHT COLUMN: REGISTRATION FORM PANEL -->
    <div class="auth-form-panel">
      
      <!-- Mobile Top Logo -->
      <div class="d-lg-none text-center mb-4">
        <img src="/images/delleventures.jpeg" alt="Delle Cards Logo" height="40" class="rounded-3 border mb-2">
        <h4 class="fw-bold text-dark mb-0">Delle<span style="color: var(--delle-gold);">Cards</span></h4>
      </div>

      <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">Create Account</h3>
        <p class="text-muted small mb-0">Register to manage events and generate custom card passes</p>
      </div>

      <!-- Flash Error Banner -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger border-0 bg-danger-subtle text-danger d-flex align-items-center gap-2.5 small py-2.5 px-3 rounded-3 mb-4" role="alert">
          <i class="bx bx-error-circle fs-5 flex-shrink-0"></i>
          <div class="fw-medium"><%= error %></div>
        </div>
      <% } %>

      <!-- Client Password Error Alert -->
      <div id="passwordMismatchAlert" class="alert alert-danger border-0 bg-danger-subtle text-danger d-none align-items-center gap-2.5 small py-2.5 px-3 rounded-3 mb-4" role="alert">
        <i class="bx bx-x-circle fs-5 flex-shrink-0"></i>
        <div class="fw-medium">Passwords do not match. Please verify your entries.</div>
      </div>

      <!-- Registration Form -->
      <form action="/register" method="POST" id="registerForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Full Name -->
        <div class="mb-3">
          <label class="form-label small fw-bold text-secondary">Full Name</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bx bx-user fs-5"></i></span>
            <input type="text" name="name" class="form-control" value="<%= typeof name !== 'undefined' ? name : '' %>" required placeholder="John Doe" autofocus>
          </div>
        </div>

        <!-- Email Address -->
        <div class="mb-3">
          <label class="form-label small fw-bold text-secondary">Email Address</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bx bx-envelope fs-5"></i></span>
            <input type="email" name="email" class="form-control" value="<%= typeof email !== 'undefined' ? email : '' %>" required placeholder="name@company.com">
          </div>
        </div>

        <!-- Password Field -->
        <div class="mb-3">
          <label class="form-label small fw-bold text-secondary">Password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bx bx-lock-alt fs-5"></i></span>
            <input type="password" name="password" id="passwordInput" class="form-control" required placeholder="••••••••">
            <button class="btn password-toggle-btn px-3 d-flex align-items-center" type="button" id="togglePasswordBtn">
              <i class="bx bx-hide fs-5" id="togglePasswordIcon"></i>
            </button>
          </div>
        </div>

        <!-- Confirm Password Field -->
        <div class="mb-4">
          <label class="form-label small fw-bold text-secondary">Confirm Password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bx bx-check-shield fs-5"></i></span>
            <input type="password" name="confirm_password" id="confirmPasswordInput" class="form-control" required placeholder="••••••••">
            <button class="btn password-toggle-btn px-3 d-flex align-items-center" type="button" id="toggleConfirmPasswordBtn">
              <i class="bx bx-hide fs-5" id="toggleConfirmPasswordIcon"></i>
            </button>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-delle-gold w-100 shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
          <span>Register Account</span>
          <i class="bx bx-user-plus fs-5"></i>
        </button>
      </form>

      <!-- Bottom Login Redirect -->
      <div class="text-center mt-4 pt-3 border-top">
        <p class="small text-muted mb-0">
          Already have an account? 
          <a href="/login" class="fw-bold text-decoration-none ms-1" style="color: var(--delle-teal);">Sign In Here</a>
        </p>
      </div>

    </div>

  </div>

  <!-- Interactive Scripts Driver -->
  <script>
    // Password 1 Toggle
    const togglePasswordBtn = document.getElementById('togglePasswordBtn');
    const passwordInput = document.getElementById('passwordInput');
    const togglePasswordIcon = document.getElementById('togglePasswordIcon');

    if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
      togglePasswordBtn.addEventListener('click', function () {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        togglePasswordIcon.classList.toggle('bx-hide', !isPassword);
        togglePasswordIcon.classList.toggle('bx-show', isPassword);
      });
    }

    // Confirm Password Toggle
    const toggleConfirmPasswordBtn = document.getElementById('toggleConfirmPasswordBtn');
    const confirmPasswordInput = document.getElementById('confirmPasswordInput');
    const toggleConfirmPasswordIcon = document.getElementById('toggleConfirmPasswordIcon');

    if (toggleConfirmPasswordBtn && confirmPasswordInput && toggleConfirmPasswordIcon) {
      toggleConfirmPasswordBtn.addEventListener('click', function () {
        const isPassword = confirmPasswordInput.getAttribute('type') === 'password';
        confirmPasswordInput.setAttribute('type', isPassword ? 'text' : 'password');
        toggleConfirmPasswordIcon.classList.toggle('bx-hide', !isPassword);
        toggleConfirmPasswordIcon.classList.toggle('bx-show', isPassword);
      });
    }

    // Real-time Password Matching Validation
    const registerForm = document.getElementById('registerForm');
    const alertBox = document.getElementById('passwordMismatchAlert');

    if (registerForm) {
      registerForm.addEventListener('submit', function (e) {
        if (passwordInput.value !== confirmPasswordInput.value) {
          e.preventDefault();
          alertBox.classList.remove('d-none');
          alertBox.classList.add('d-flex');
          confirmPasswordInput.focus();
        } else {
          alertBox.classList.add('d-none');
          alertBox.classList.remove('d-flex');
        }
      });
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>