<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#073a4a">
  <title>Create account | Delle Cards</title>

  <link rel="icon" type="image/jpeg" href="/images/delleventures.jpeg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <style>
    :root {
      --delle-teal: #0e697b; --delle-teal-hover: #0a5160; --delle-teal-deep: #073a4a; --delle-teal-soft: rgba(14,105,123,.08);
      --delle-gold: #e5a000; --delle-gold-soft: rgba(229,160,0,.14);
      --ink: #0f2530; --muted: #5d7079; --line: rgba(15,37,48,.14); --ok: #198754; --bad: #c2255c;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: var(--ink); background: #fff; -webkit-font-smoothing: antialiased; }
    .serif { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -.015em; }
    :focus-visible { outline: 3px solid var(--delle-gold); outline-offset: 2px; }

    .auth { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }

    /* ---------- Brand panel ---------- */
    .hero { position: relative; overflow: hidden; background: linear-gradient(145deg, var(--delle-teal-deep) 0%, var(--delle-teal) 100%); color: #fff; padding: 3rem 3.5rem; display: flex; flex-direction: column; }
    .hero::before, .hero::after { content: ''; position: absolute; border-radius: 50%; pointer-events: none; border: 1px solid rgba(229,160,0,.32); }
    .hero::before { width: 520px; height: 520px; right: -170px; bottom: -190px; box-shadow: 0 0 0 48px rgba(229,160,0,.045), 0 0 0 104px rgba(229,160,0,.03); }
    .hero::after { width: 200px; height: 200px; left: -70px; top: 38%; border-color: rgba(255,255,255,.12); }
    .brand { display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; position: relative; z-index: 2; }
    .brand img { width: 42px; height: 42px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(255,255,255,.3); }
    .brand .w { font-size: 1.45rem; color: #fff; } .brand .w span { color: var(--delle-gold); }

    .hero-main { margin: auto 0; padding: 2.5rem 0; position: relative; z-index: 2; max-width: 500px; }
    .hero h1 { font-size: clamp(2rem, 3.2vw, 2.9rem); line-height: 1.1; margin: 0 0 1rem; color: #fff; }
    .hero p.lead { color: rgba(255,255,255,.8); font-size: 1.02rem; line-height: 1.6; margin: 0 0 2.2rem; max-width: 440px; }

    .flow { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
    .flow li { display: grid; grid-template-columns: 40px 1fr; gap: 1rem; position: relative; padding-bottom: 1.6rem; }
    .flow li:last-child { padding-bottom: 0; }
    .flow li:not(:last-child)::before { content: ''; position: absolute; left: 19px; top: 40px; bottom: 0; width: 2px; background: linear-gradient(var(--delle-gold), rgba(229,160,0,.15)); }
    .flow .n { width: 40px; height: 40px; border-radius: 50%; background: var(--delle-gold); color: #1d1500; font-weight: 700; display: grid; place-items: center; }
    .flow b { display: block; font-size: 1.02rem; margin-top: .1rem; } .flow span { color: rgba(255,255,255,.72); font-size: .9rem; line-height: 1.5; }

    .hero-foot { position: relative; z-index: 2; font-size: .82rem; color: rgba(255,255,255,.6); }

    /* ---------- Form panel ---------- */
    .panel { display: flex; flex-direction: column; justify-content: center; padding: 3rem 2rem; position: relative; }
    .panel-in { width: 100%; max-width: 420px; margin: 0 auto; }
    .m-brand { display: none; margin-bottom: 1.8rem; }
    .m-brand .w { font-size: 1.4rem; color: var(--delle-teal); } .m-brand .w span { color: var(--delle-gold); }
    .m-brand img { width: 40px; height: 40px; border-radius: 11px; object-fit: cover; border: 1px solid var(--line); }

    .panel h2 { font-size: 2rem; margin: 0 0 .4rem; color: var(--delle-teal-deep); }
    .panel .sub { color: var(--muted); margin: 0 0 1.6rem; }

    .alert-x { display: flex; gap: .6rem; align-items: flex-start; background: rgba(194,37,92,.08); color: #8c1d46; border-radius: 12px; padding: .8rem 1rem; font-size: .9rem; font-weight: 500; margin-bottom: 1.25rem; }
    .alert-x i { font-size: 1.25rem; flex: none; margin-top: 1px; }

    .fld { margin-bottom: 1.05rem; }
    .fld label { display: block; font-size: .86rem; font-weight: 600; margin-bottom: .4rem; }
    .inp { position: relative; }
    .inp > i.lead-ic { position: absolute; left: .95rem; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 1.2rem; pointer-events: none; }
    .inp input { width: 100%; height: 52px; border: 1.5px solid var(--line); border-radius: 12px; padding: 0 3rem 0 2.8rem; font-size: .98rem; background: #fff; color: var(--ink); transition: border-color .15s, box-shadow .15s; }
    .inp input.plain { padding-right: .9rem; }
    .inp input::placeholder { color: #93a3ab; }
    .inp input:hover { border-color: rgba(14,105,123,.45); }
    .inp input:focus { outline: 0; border-color: var(--delle-teal); box-shadow: 0 0 0 4px rgba(14,105,123,.15); }
    .inp input.bad { border-color: var(--bad); } .inp input.good { border-color: var(--ok); }
    .eye { position: absolute; right: .35rem; top: 50%; transform: translateY(-50%); width: 42px; height: 42px; border: 0; background: transparent; color: var(--muted); border-radius: 10px; font-size: 1.3rem; display: grid; place-items: center; }
    .eye:hover { background: var(--delle-teal-soft); color: var(--delle-teal); }

    .meter { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; margin-top: .6rem; }
    .meter i { height: 5px; border-radius: 3px; background: #e2eaed; transition: background .2s; }
    .meter[data-s="1"] i:nth-child(-n+1) { background: var(--bad); }
    .meter[data-s="2"] i:nth-child(-n+2) { background: var(--delle-gold); }
    .meter[data-s="3"] i:nth-child(-n+3) { background: var(--delle-teal); }
    .meter[data-s="4"] i { background: var(--ok); }
    .hint { font-size: .8rem; color: var(--muted); margin-top: .4rem; min-height: 1.2em; }
    .hint.ok { color: var(--ok); font-weight: 600; } .hint.no { color: var(--bad); font-weight: 600; }

    .btn-go { width: 100%; height: 54px; margin-top: .7rem; border: 0; border-radius: 12px; background: var(--delle-teal); color: #fff; font-weight: 700; font-size: 1rem; display: inline-flex; align-items: center; justify-content: center; gap: .6rem; transition: background .15s, box-shadow .15s; }
    .btn-go:hover:not(:disabled) { background: var(--delle-teal-hover); box-shadow: 0 10px 24px rgba(14,105,123,.28); }
    .btn-go:disabled { opacity: .75; cursor: progress; }
    .btn-go i { font-size: 1.3rem; transition: transform .2s; } .btn-go:hover:not(:disabled) i { transform: translateX(3px); }

    .alt { margin-top: 1.6rem; padding-top: 1.3rem; border-top: 1px solid var(--line); text-align: center; color: var(--muted); font-size: .92rem; }
    .alt a { color: var(--delle-teal); font-weight: 700; text-decoration: none; margin-left: .3rem; } .alt a:hover { text-decoration: underline; }

    @media (max-width: 991.98px) {
      .auth { grid-template-columns: 1fr; }
      .hero { display: none; }
      .m-brand { display: inline-flex; }
      .panel { min-height: 100vh; padding: 2rem 1.4rem; }
      .panel::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 6px; background: linear-gradient(90deg, var(--delle-teal-deep), var(--delle-teal), var(--delle-gold)); }
    }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</head>

<body>
  <div class="auth">

    <!-- Brand panel -->
    <aside class="hero">
      <a href="/" class="brand" aria-label="Delle Cards">
        <img src="/images/delleventures.jpeg" alt="">
        <span class="w serif">Delle<span>Cards</span></span>
      </a>

      <div class="hero-main">
        <h1 class="serif">Your first event, ready in minutes.</h1>
        <p class="lead">Create an account and you can start inviting guests the same day.</p>

        <ol class="flow">
          <li><div class="n">1</div><div><b>Create your event</b><span>Add the date, venue and your invitation card design.</span></div></li>
          <li><div class="n">2</div><div><b>Import your guests</b><span>Upload a CSV and each guest gets their own entry code.</span></div></li>
          <li><div class="n">3</div><div><b>Send and check in</b><span>Invite by SMS or WhatsApp, then scan guests in at the door.</span></div></li>
        </ol>
      </div>

      <div class="hero-foot">&copy; <%= new Date().getFullYear() %> Delle Ventures</div>
    </aside>

    <!-- Form panel -->
    <main class="panel">
      <div class="panel-in">

        <a href="/" class="brand m-brand" aria-label="Delle Cards">
          <img src="/images/delleventures.jpeg" alt="">
          <span class="w serif">Delle<span>Cards</span></span>
        </a>

        <h2 class="serif">Create your account</h2>
        <p class="sub">It takes less than a minute.</p>

        <div id="errorAlertContainer" aria-live="assertive">
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-x" role="alert"><i class="bx bx-error-circle"></i><span id="errorText"><%= error %></span></div>
          <% } %>
        </div>

        <form action="/register" method="POST" id="registerForm" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="fld">
            <label for="nameInput">Full name</label>
            <div class="inp">
              <i class="bx bx-user lead-ic"></i>
              <input type="text" name="name" id="nameInput" class="plain" value="<%= typeof name !== 'undefined' ? name : '' %>" required placeholder="John Doe" autocomplete="name" autofocus>
            </div>
          </div>

          <div class="fld">
            <label for="emailInput">Email address</label>
            <div class="inp">
              <i class="bx bx-envelope lead-ic"></i>
              <input type="email" name="email" id="emailInput" class="plain" value="<%= typeof email !== 'undefined' ? email : '' %>" required placeholder="name@company.com" autocomplete="email">
            </div>
          </div>

          <div class="fld">
            <label for="passwordInput">Password</label>
            <div class="inp">
              <i class="bx bx-lock-alt lead-ic"></i>
              <input type="password" name="password" id="passwordInput" required placeholder="Create a password" autocomplete="new-password" aria-describedby="pwHint">
              <button type="button" class="eye" data-eye="passwordInput" aria-label="Show password" aria-pressed="false"><i class="bx bx-hide"></i></button>
            </div>
            <div class="meter" id="meter" data-s="0" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="hint" id="pwHint" aria-live="polite">Use 8 or more characters with letters and numbers.</div>
          </div>

          <div class="fld">
            <label for="confirmPasswordInput">Confirm password</label>
            <div class="inp">
              <i class="bx bx-check-shield lead-ic"></i>
              <input type="password" name="confirm_password" id="confirmPasswordInput" required placeholder="Type it again" autocomplete="new-password" aria-describedby="matchHint">
              <button type="button" class="eye" data-eye="confirmPasswordInput" aria-label="Show password" aria-pressed="false"><i class="bx bx-hide"></i></button>
            </div>
            <div class="hint" id="matchHint" aria-live="polite"></div>
          </div>

          <button type="submit" id="submitBtn" class="btn-go">
            <span id="btnText">Create account</span>
            <i class="bx bx-right-arrow-alt" id="btnIcon"></i>
            <span class="spinner-border spinner-border-sm d-none" id="btnSpin"></span>
          </button>
        </form>

        <div class="alt">Already have an account?<a href="/login">Sign in</a></div>
      </div>
    </main>
  </div>

  <script>
    (function () {
      const $ = id => document.getElementById(id);
      const form = $('registerForm'), pw = $('passwordInput'), cpw = $('confirmPasswordInput'), box = $('errorAlertContainer');

      /* Show / hide password (both fields) */
      document.querySelectorAll('[data-eye]').forEach(btn => btn.addEventListener('click', () => {
        const input = $(btn.dataset.eye), show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.setAttribute('aria-pressed', show);
        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        btn.querySelector('i').className = 'bx ' + (show ? 'bx-show' : 'bx-hide');
      }));

      /* Password strength: advice only, the server rules decide what is accepted */
      const LABELS = ['', 'Weak. Add more characters.', 'Fair. Try mixing letters and numbers.', 'Good.', 'Strong.'];
      function strength(v) {
        if (!v) return 0;
        let s = 0;
        if (v.length >= 8) s++;
        if (/[a-z]/.test(v) && /[A-Z]/.test(v)) s++;
        if (/\d/.test(v)) s++;
        if (/[^A-Za-z0-9]/.test(v) || v.length >= 14) s++;
        return Math.max(1, s);
      }
      function updateStrength() {
        const s = strength(pw.value);
        $('meter').dataset.s = s;
        $('pwHint').textContent = s ? LABELS[s] : 'Use 8 or more characters with letters and numbers.';
        updateMatch();
      }
      function updateMatch() {
        const h = $('matchHint');
        if (!cpw.value) { h.textContent = ''; h.className = 'hint'; cpw.classList.remove('good', 'bad'); return true; }
        const same = pw.value === cpw.value;
        h.textContent = same ? 'Passwords match.' : 'Passwords do not match yet.';
        h.className = 'hint ' + (same ? 'ok' : 'no');
        cpw.classList.toggle('good', same); cpw.classList.toggle('bad', !same);
        return same;
      }
      pw.addEventListener('input', updateStrength);
      cpw.addEventListener('input', updateMatch);

      function showError(msg) {
        box.innerHTML = '';
        const d = document.createElement('div'); d.className = 'alert-x'; d.setAttribute('role', 'alert');
        d.innerHTML = '<i class="bx bx-error-circle"></i>';
        const s = document.createElement('span'); s.textContent = msg; d.appendChild(s);
        box.appendChild(d);
        box.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
      function setLoading(on) {
        $('submitBtn').disabled = on;
        $('btnText').textContent = on ? 'Creating account…' : 'Create account';
        $('btnIcon').classList.toggle('d-none', on);
        $('btnSpin').classList.toggle('d-none', !on);
      }

      /* Sent once with fetch so rate-limit and validation messages appear in place.
         There is no fallback re-submit, so one click never creates two requests. */
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        box.innerHTML = '';

        if (pw.value !== cpw.value) {
          showError('Passwords do not match. Please check both entries.');
          cpw.focus();
          return;
        }

        setLoading(true);
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;

        try {
          const res = await fetch('/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'CSRF-Token': csrf },
            body: new URLSearchParams(new FormData(form)).toString()
          });

          if (res.redirected) { window.location.href = res.url; return; }

          let message = '';
          const type = res.headers.get('content-type') || '';
          if (type.includes('application/json')) {
            const data = await res.json().catch(() => ({}));
            message = data.error || data.message || '';
          } else {
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            message = doc.getElementById('errorText')?.textContent.trim() || '';
          }
          if (!message) message = res.status === 429 ? 'Too many attempts. Please try again later.' : 'We could not create your account. Please check your details and try again.';
          showError(message);
        } catch (err) {
          console.error(err);
          showError('We could not reach the server. Check your connection and try again.');
        } finally {
          setLoading(false);
        }
      });
    })();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
