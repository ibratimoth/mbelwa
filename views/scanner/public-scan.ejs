<!DOCTYPE html>
<html>
<head>

  <title><%= event.title %> - Scanner</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <script src="https://unpkg.com/html5-qrcode"></script>

  <style>
    body {
      background: #f8f9fa;
    }

    #qr-reader {
      width: 100%;
      max-width: 360px;
      margin: auto;
    }

    .scanner-box {
      max-width: 420px;
      margin: 40px auto;
      text-align: center;
    }
  </style>

</head>

<body>

<div class="scanner-box">

  <h3 class="mb-2">
    <%= event.title %>
  </h3>

  <p class="text-muted mb-3">
    Event QR Scanner
  </p>

  <button id="start-scanner-btn" class="btn btn-primary mb-3">
    Start Scanner
  </button>

  <div id="scanner-section" style="display:none;">

    <div id="qr-reader"></div>

    <div id="scanner-alert" class="alert mt-3 d-none"></div>

    <div class="mt-3">

      <div id="scans-remaining" class="mb-2 text-muted">
        Ready
      </div>

      <button id="stop-scanner-btn" class="btn btn-danger">
        Stop Scanner
      </button>

    </div>

  </div>

</div>

<script>

let scanner;
let lastScanTime = 0;
const SCAN_DELAY = 2000;

const startBtn = document.getElementById('start-scanner-btn');
const stopBtn = document.getElementById('stop-scanner-btn');
const section = document.getElementById('scanner-section');
const alertBox = document.getElementById('scanner-alert');
const scansEl = document.getElementById('scans-remaining');

function show(msg, type) {
  alertBox.className = `alert alert-${type}`;
  alertBox.innerText = msg;
  alertBox.classList.remove('d-none');

  setTimeout(() => {
    alertBox.classList.add('d-none');
  }, 2500);
}

function playBeep(type) {
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();

  osc.connect(gain);
  gain.connect(ctx.destination);

  osc.type = "sine";
  osc.frequency.value = type === "success" ? 800 : 200;
  gain.gain.value = 0.1;

  osc.start();
  setTimeout(() => {
    osc.stop();
    ctx.close();
  }, 200);
}

function flash(type) {
  const div = document.createElement("div");

  div.style.position = "fixed";
  div.style.top = 0;
  div.style.left = 0;
  div.style.width = "100%";
  div.style.height = "100%";
  div.style.zIndex = 9999;
  div.style.opacity = 0.4;
  div.style.background = type === "success" ? "green" : "red";

  document.body.appendChild(div);

  setTimeout(() => div.remove(), 200);
}

startBtn.onclick = () => {

  section.style.display = 'block';

  scanner = new Html5Qrcode("qr-reader");

  scanner.start(
    { facingMode: "environment" },
    { fps: 10, qrbox: 250 },

    async (text) => {

      const now = Date.now();
      if (now - lastScanTime < SCAN_DELAY) return;
      lastScanTime = now;

      try {

        const res = await fetch(
          '/scanner/<%= event.scanner_token %>/scan',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ qrData: text })
          }
        );

        const data = await res.json();

        show(data.message, data.success ? 'success' : 'danger');

        playBeep(data.success ? "success" : "error");
        flash(data.success ? "success" : "error");

        if (data.scansRemaining !== undefined) {
          scansEl.innerText =
            `Scans remaining: ${data.scansRemaining}`;
        }

      } catch (err) {
        show("Network error", "danger");
        playBeep("error");
        flash("error");
      }

    }
  );
};

stopBtn.onclick = () => {
  if (scanner) scanner.stop();
  section.style.display = 'none';
};

</script>

</body>
</html>