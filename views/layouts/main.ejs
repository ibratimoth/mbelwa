<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wedding Card Manager</title>

  <!-- Google Fonts for a clean, modern look -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <script src="https://unpkg.com/html5-qrcode"></script>

  <style>
    :root {
      /* Logo-inspired Color Palette */
      --delle-teal: #0E6171;
      --delle-teal-hover: #0a4854;
      --delle-gold: #E0A21E;
      --delle-gold-hover: #c48c17;
      --delle-light-bg: #f8f9fa;
      --delle-dark: #212529;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--delle-light-bg);
      color: var(--delle-dark);
      padding-top: 85px;
    }

    /* Branded Navbar Styling */
    .navbar-branded {
      background-color: #ffffff;
      border-bottom: 2px solid var(--delle-teal);
    }

    .navbar-brand-text {
      color: var(--delle-teal);
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .navbar-brand-text span {
      color: var(--delle-gold);
    }

    /* Dynamic Event Badge */
    .badge-event {
      background-color: rgba(14, 97, 113, 0.1);
      color: var(--delle-teal);
      border: 1px solid rgba(14, 97, 113, 0.2);
      font-weight: 500;
      padding: 0.5rem 0.75rem;
    }

    /* Brand System Buttons */
    .btn-delle-teal {
      background-color: var(--delle-teal);
      color: #ffffff;
      border: 1px solid var(--delle-teal);
      transition: all 0.2s ease-in-out;
    }

    .btn-delle-teal:hover {
      background-color: var(--delle-teal-hover);
      color: #ffffff;
    }

    .btn-delle-outline {
      background-color: transparent;
      color: var(--delle-teal);
      border: 1px solid var(--delle-teal);
      transition: all 0.2s ease-in-out;
    }

    .btn-delle-outline:hover {
      background-color: var(--delle-teal);
      color: #ffffff;
    }

    .btn-delle-gold {
      background-color: var(--delle-gold);
      color: #ffffff;
      border: 1px solid var(--delle-gold);
      transition: all 0.2s ease-in-out;
    }

    .btn-delle-gold:hover {
      background-color: var(--delle-gold-hover);
      color: #ffffff;
    }

    /* Draggable elements interface */
    .draggable {
      position: absolute;
      padding: 6px 10px;
      background: rgba(14, 97, 113, 0.85);
      color: white;
      border-radius: 6px;
      cursor: grab;
      user-select: none;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-light fixed-top navbar-branded shadow-sm">
    <div class="container">

      <!-- Logo Branding Integration -->
      <a href="/" class="navbar-brand d-flex align-items-center gap-2">
        <img src="/images/delleventures.jpeg" alt="Delle Logo" height="35" class="d-inline-block align-top rounded">
        <span class="navbar-brand-text mb-0 h6 fw-bold">Wedding<span>Manager</span></span>
      </a>

      <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav"
        aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="nav">

        <% if (typeof event !=='undefined' && event) { %>
          <div class="ms-lg-3 my-2 my-lg-0 me-auto">
            <span class="badge badge-event d-inline-flex align-items-center gap-1">
              <i class="bx bx-calendar fs-6"></i>
              <%= event.title %>
            </span>
          </div>
          <% } %>

            <div class="ms-auto d-flex flex-wrap gap-2 align-items-center">
              <% if (typeof isAuthenticated !=='undefined' && isAuthenticated) { %>

                <% if (typeof event !=='undefined' && event) { %>
                  <a href="/events/<%= event.id %>/guests"
                    class="btn btn-delle-outline btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-group"></i> Guests
                  </a>

                  <a href="/events/<%= event.id %>/guests/upload"
                    class="btn btn-delle-outline btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-upload"></i> Upload
                  </a>

                  <a href="/events/<%= event.id %>/scan"
                    class="btn btn-delle-outline btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-qr-scan"></i> Scan
                  </a>

                  <a href="/events/<%= event.id %>"
                    class="btn btn-delle-teal btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-wreath"></i> My Event
                  </a>
                  <% } %>

                    <a href="/" class="btn btn-delle-gold btn-sm d-inline-flex align-items-center gap-1">
                      <i class="bx bx-grid-alt"></i> Dashboard
                    </a>

                    <form action="/logout" method="POST" class="d-inline">
                      <button type="submit"
                        class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1">
                        <i class="bx bx-log-out"></i> Logout
                      </button>
                    </form>

                    <% } else { %>

                      <a href="/login" class="btn btn-delle-outline btn-sm d-inline-flex align-items-center gap-1">
                        <i class="bx bx-log-in"></i> Sign In
                      </a>

                      <a href="/register" class="btn btn-delle-teal btn-sm d-inline-flex align-items-center gap-1">
                        <i class="bx bx-user-plus"></i> Register
                      </a>

                      <% } %>
            </div>

      </div>
    </div>
  </nav>

  <!-- Inner Page Dynamic Body Injection -->
  <main class="container mb-5">
    <%- body %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>